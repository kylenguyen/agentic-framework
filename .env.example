# Host parameters for install-host.sh and install-mac.sh. Copy to .env (gitignored) in this checkout, on the host and
# on every Mac. Names, an address and a login only; secrets go in ~/.config/agents/env (see secrets.env.example).
# On the host every value is derived from the system when absent, and install-host.sh prints the resulting file for
# the Macs. On the Mac, AGENT_HOST and AGENT_HOST_USER are required; install-mac.sh asks for them when .env is missing.
# Details and the derivation rules: lib/params.sh. The values below are examples: replace every one of them.
AGENT_HOST=agent-host
AGENT_HOST_ADDRESS=agent-host.example.ts.net
AGENT_HOST_USER=agent
AGENT_HOST_LAN_IP=192.168.1.10
AGENT_HOST_LAN_CIDR=192.168.1.0/24
