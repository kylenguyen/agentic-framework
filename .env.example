# Host parameters for install-as1.sh and install-mac.sh. Copy to .env (gitignored) in this checkout, on the host and
# on every Mac. Names, an address and a login only; secrets go in ~/.config/agents/env (see secrets.env.example).
# On the host every value is derived from the system when absent, and install-as1.sh prints the resulting file for
# the Macs. On the Mac, AGENT_HOST and AGENT_HOST_USER are required; install-mac.sh asks for them when .env is missing.
# Details and the derivation rules: lib/params.sh. The values below are examples.
AGENT_HOST=as1
AGENT_HOST_ADDRESS=as1
AGENT_HOST_USER=kyle
AGENT_HOST_LAN_IP=192.168.10.2
AGENT_HOST_LAN_CIDR=192.168.10.0/24
