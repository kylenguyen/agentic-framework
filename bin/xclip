#!/usr/bin/env bash
# xclip shim for a headless host: serves the clipboard that the attached Mac pushed here.
# Installed as ~/.local/bin/xclip (ahead of /usr/bin; do NOT apt install xclip).
#
# Data flow: Cmd+V in WezTerm runs clip-push on the Mac; when the Mac clipboard holds an image it is piped over
# SSH into clip-put on this host, which writes the spool file ~/.clip/latest, and WezTerm then sends Ctrl+V,
# the key Claude Code reads the clipboard on. Claude Code calls xclip:
#
# Claude Code calls:                                    shim:
#   xclip -selection clipboard -t TARGETS -o          -> image/png if the spool starts with the PNG magic, else text/plain UTF8_STRING
#   xclip -selection clipboard -t image/png -o        -> the spool, raw PNG (exit 1 if it is not a PNG)
#   xclip -selection clipboard -t text/plain -o | -o  -> the spool (exit 1 if it is a PNG)
#   xclip -selection clipboard|primary  (stdin)       -> stdin -> spool, plus OSC 52 to the terminal so the Mac clipboard follows
# A missing or empty spool, or any other argument pattern, exits 1 so the caller falls through to its next option.
#
# Overrides: CLIP_BRIDGE_SPOOL=/path/file (spool location; point it at any PNG to test without a Mac)
#            CLIP_BRIDGE_DEBUG=1 (trace to stderr)
set -u

log() { [ -n "${CLIP_BRIDGE_DEBUG:-}" ] && printf 'xclip-shim: %s\n' "$*" >&2; return 0; }
is_png() { head -c 8 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n' | grep -q '^89504e470d0a1a0a$'; }

spool=${CLIP_BRIDGE_SPOOL:-$HOME/.clip/latest}
sel=clipboard target= out=0
while [ $# -gt 0 ]; do
  case $1 in
    -selection|-sel|-se|-s) [ $# -ge 2 ] || exit 1; sel=$2; shift 2 ;;
    -t|-target|-targ)       [ $# -ge 2 ] || exit 1; target=$2; shift 2 ;;
    -l|-loops|-d|-display)  [ $# -ge 2 ] || exit 1; shift 2 ;;
    -o|-out)                out=1; shift ;;
    -i|-in|-quiet|-silent|-verbose|-noutf8|-rmlastnl) shift ;;
    *) log "unsupported arg: $1"; exit 1 ;;
  esac
done
case $sel in clipboard|primary|secondary) ;; *) exit 1 ;; esac

if [ "$out" = 1 ]; then
  case $target in
    TARGETS)                       op=targets ;;
    image/png)                     op=image ;;
    ""|text/plain*|UTF8_STRING|STRING|TEXT) op=text ;;
    *) log "unsupported target: $target"; exit 1 ;;
  esac
else
  op=copy
fi
log "sel=$sel op=$op spool=$spool"

if [ "$op" = copy ]; then
  dir=$(dirname "$spool")
  install -d -m 700 "$dir" || exit 1
  tmp=$(mktemp "$dir/.put.XXXXXX") || exit 1
  if ! cat > "$tmp" || ! chmod 600 "$tmp" || ! mv -f "$tmp" "$spool"; then rm -f "$tmp"; exit 1; fi
  # Best effort OSC 52: tmux (set-clipboard on) forwards it to WezTerm, which writes the Mac clipboard.
  # Without a controlling terminal (systemd job, plain `ssh as1 cmd`) the copy simply stays in the spool.
  if { exec 3>/dev/tty; } 2>/dev/null; then
    printf '\033]52;c;%s\a' "$(base64 < "$spool" | tr -d '\n')" >&3 || true
    exec 3>&-
  fi
  exit 0
fi

[ -s "$spool" ] || { log "spool missing or empty"; exit 1; }
case $op in
  targets) if is_png "$spool"; then echo image/png; else echo 'text/plain UTF8_STRING'; fi ;;
  image)   is_png "$spool" || { log "spool is not a PNG"; exit 1; }; exec cat "$spool" ;;
  text)    if is_png "$spool"; then log "spool is a PNG, not text"; exit 1; fi; exec cat "$spool" ;;
esac
