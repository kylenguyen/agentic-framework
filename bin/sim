#!/usr/bin/env bash
# sim: the device simulation service from the command line, for agents and the operator. Model and ports: lib/sim.sh.
# The MCP servers an agent drives the devices with are started by its harness (bin/sim-mcp); this command does what
# MCP does not: registering a repo, Metro, builds that need the slot's environment, the Mac side, and status.
#
#   sim status                          slots per platform, who holds them, what runs, minutes since last use
#   sim enable [--only P,P] [dir]       register sim-android, sim-web, sim-ios with every harness for one repo; .sim/config if absent
#   sim wait [secs]                     block until this worktree's emulator has booted (default 180 s)
#   sim env                             exports for this worktree's emulator: eval "$(sim env)"
#   sim run <cmd...>                    run a command in that environment, e.g. sim run ./gradlew test
#   sim ports <P> [k|--check]           this worktree's 100 ports for test stacks: eval "$(sim ports web)"; k lists k, --check busy ones
#   sim build [args]                    from the app's directory: Metro if not running, then expo run:android for the slot
#   sim maestro android|ios <args...>   Maestro on this worktree's emulator or simulator, a directory per run: sim maestro ios test .maestro/
#                                       ios --forward p[,p...]|none: host ports reachable from the Mac for the run (sim tunnel)
#   sim tunnel ios [p[,p...]] [--background|--stop|--any-port]   host 127.0.0.1:<p> as 127.0.0.1:<p> on the Mac; ports from sim ports ios
#   sim maestro P --fresh|--cold ...    first stop Maestro's driver (--fresh), or restart the device (--cold; android: app gone)
#   sim metro start|stop|log <P>        Metro for this worktree's slot: android (adb reverse), web, ios (on the Mac)
#   sim metro start <P> [--env K=V]...  with EXPO_PUBLIC_*, the names in SIM_METRO_ENV and each K=V; returns once it answers
#   sim android start|stop|logs <N|all> the emulator units
#   sim android restart <N|all>         cold restart of an emulator and its mobilecli daemon; the app is gone (sim build)
#   sim doctor [P] [N|all]              why a device or driver is unhealthy: this worktree's slots, slot N, or all slots
#   sim ios start|stop <N|all>          boot or shut down simulators agent-ios-N on the Mac
#   sim reap                            stop the devices and Metro of slots unused for AGENT_SIM_IDLE_MINUTES (timer)
#   sim ios sync                        rsync this worktree to the Mac, print its path there
#   sim ios prepare                     sync, then npm ci, expo prebuild and pod install on the Mac
#   sim ios bootstrap                   install or update the runner on the Mac (install-ios-runner.sh)
#   sim ios gc [days]                   remove trees not synced and build output unused for N days (default 7)
#   sim lease <P> [--ttl DUR] [dir]     hold a slot for this worktree without an MCP server: DUR <n>m|h|d, 8h, at most 7d
#   sim release <P> [dir]               free the slot that sim lease took
# "This worktree's slot" is the slot leased by an MCP server started from the same git top level, or by sim lease.
# A repo's committed .sim/config states its needs (stack, app_dir, metro_env, forward_ios, ports, keep_runs; lib/sim.sh,
# sim_repo_config): flags and environment variables beat it, it beats the host's .env. A bad file is rc 2.
# Exit codes: 0 done, 1 failed, 2 usage, 3 the device or the Mac is unavailable (unreachable): retry later.
# Devices start on first use and stop when unused (lib/sim.sh, Uptime); the commands that use one count as use.
set -euo pipefail
REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
. "$REPO/lib/sim.sh"
die() { printf 'sim: %s\n' "$*" >&2; exit "${2:-1}"; }
unavailable() { printf 'sim: %s\n' "$*" >&2; exit 3; }   # the device or the Mac cannot be reached now: retry later
usage() { sed -n '/^#   sim/s/^# *//p' "${BASH_SOURCE[0]}" >&2; exit 2; }
sim_load_params

my_slot() { # my_slot <platform>: this worktree's slot, or a message that says how to get one
  sim_my_slot "$1" || die "no $1 slot is leased for $(sim_root): start a harness session in this worktree after \`sim enable\`, so its sim-$1 MCP server holds one, or sim lease $1"
}

# repo_cfg: read this worktree's .sim/config (lib/sim.sh, sim_repo_config) once, before anything uses its keys; a bad
# file is rc 2. Commands call it in the main shell, never in $(...), so the SIM_CFG_* variables stay set.
REPO_CFG_READ=
repo_cfg() {
  [ -z "$REPO_CFG_READ" ] || return 0
  sim_repo_apply "$(sim_root)" || exit 2
  REPO_CFG_READ=1
}

# app_rel <root>: the app's directory relative to the root: where sim runs, or app_dir from .sim/config when sim runs
# at the root (call repo_cfg first). rc 2 when app_dir names no directory.
app_rel() {
  local a; a=$(sim_app_rel "$PWD" "$1")
  if [ "$a" = . ] && [ -n "${SIM_CFG_APP_DIR:-}" ]; then
    [ -d "$1/$SIM_CFG_APP_DIR" ] || die ".sim/config: app_dir = $SIM_CFG_APP_DIR: no such directory in $1" 2
    a=$(realpath -m --relative-to="$1" "$1/$SIM_CFG_APP_DIR")
  fi
  echo "$a"
}

# ios_states: fill IOS_STATE[N] for every ios slot: booted, off (shut down, by `sim reap` or by hand), unreachable
# or unconfigured. A fresh probe, then one `simctl list` for all slots.
declare -A IOS_STATE=()
ios_states() {
  local count n st list='' rc=0
  count=$(sim_slots ios)
  [ "$count" -gt 0 ] || return 0
  sim_mac_probe --fresh || rc=$?
  if [ "$rc" = 0 ]; then
    list=$(SIM_SSH_TIMEOUT=20 sim_ios_ssh 'xcrun simctl list devices' </dev/null 2>/dev/null) || { sim_mac_record down; rc=1; }
  fi
  for ((n = 1; n <= count; n++)); do
    case $rc in
      0) st=off; grep -F "$(sim_ios_name "$n") (" <<<"$list" | grep -q '(Booted)' && st=booted ;;
      2) st=unconfigured ;;
      *) st=unreachable ;;
    esac
    IOS_STATE[$n]=$st
  done
}

cmd_status() {
  local p n count state idle run tunnel
  ios_states
  for p in $SIM_PLATFORMS; do
    count=$(sim_slots "$p")
    for ((n = 1; n <= count; n++)); do
      state=$(lease_state "$p" "$n")
      idle=$(sim_idle_secs "$p" "$n") && idle="used $((idle / 60))m ago" || idle=unused
      case $p in
        android) run=$(systemctl --user is-active "$(sim_android_unit "$n")" 2>/dev/null || true)
                 printf '%-8s %s  %-14s %-8s %-15s %s\n' "$p" "$n" "$(sim_android_serial "$n")" "$run" "$idle" "$state" ;;
        web)     printf '%-8s %s  %-14s %-8s %-15s %s\n' "$p" "$n" "port $(sim_metro_port web "$n")" - "$idle" "$state" ;;
        ios)     run=${IOS_STATE[$n]:--}
                 tunnel=$(tunnel_live "$n") && state+="  tunnel $tunnel"
                 printf '%-8s %s  %-14s %-8s %-15s %s\n' "$p" "$n" "$(sim_ios_name "$n")" "$run" "$idle" "$state" ;;
      esac
    done
  done
}

# reap_ios_reachable: whether this round may reach the Mac; probed once, when the first idle simulator needs it.
reap_ios=''
reap_ios_reachable() {
  if [ -z "$reap_ios" ]; then
    local rc=0; sim_mac_probe || rc=$?
    case $rc in
      0) reap_ios=up ;;
      2) reap_ios=none ;;
      *) reap_ios=down; echo "ios: $AGENT_IOS_HOST unreachable, next round tries again" >&2 ;;
    esac
  fi
  [ "$reap_ios" = up ]
}

# Stops what an idle slot runs (lib/sim.sh, Uptime). A slot never used since boot starts its clock now, so an
# emulator someone started by hand gets the full idle time too. Prints one line per thing stopped.
cmd_reap() {
  local limit=$((10#$AGENT_SIM_IDLE_MINUTES * 60)) p n count idle unit
  reap_leases
  reap_tunnels
  [ "$limit" -gt 0 ] || return 0
  for p in $SIM_PLATFORMS; do
    count=$(sim_slots "$p")
    for ((n = 1; n <= count; n++)); do
      idle=$(sim_idle_secs "$p" "$n") || { sim_touch "$p" "$n"; continue; }
      [ "$idle" -ge "$limit" ] || continue
      case $p in
        android)
          unit=$(sim_android_unit "$n")
          if systemctl --user is-active -q "$unit"; then
            systemctl --user stop "$unit" && echo "android $n: emulator stopped, unused for $((idle / 60)) min"
          fi ;;
        ios)
          [ ! -e "$SIM_STATE/ios/$n.down" ] || continue
          reap_ios_reachable || continue
          if sim_ios_shutdown "$n"; then touch "$SIM_STATE/ios/$n.down"; rm -f "$SIM_STATE/ios/$n.booted"; echo "ios $n: $(sim_ios_name "$n") shut down, unused for $((idle / 60)) min"
          else echo "ios $n: $AGENT_IOS_HOST did not answer, next round tries again" >&2; fi ;;
      esac
      [ "$p" = ios ] || ! metro_stop_slot "$p" "$n" || echo "$p $n: Metro stopped"
    done
  done
}

cmd_enable() {
  local only=$SIM_PLATFORMS dir=. p root
  while [ $# -gt 0 ]; do
    case $1 in
      --only) only=${2//,/ }; shift 2 ;;
      -*) usage ;;
      *) dir=$1; shift ;;
    esac
  done
  for p in $only; do case " $SIM_PLATFORMS " in *" $p "*) ;; *) die "unknown platform: $p" 2 ;; esac; done
  root=$(sim_root "$dir")
  # shellcheck disable=SC2086
  { sim_write_mcp_json "$root/.mcp.json" $only && sim_write_opencode_json "$root/opencode.json" $only \
      && sim_write_codex_toml "$root/.codex/config.toml" $only; } || exit 1
  printf 'wrote .mcp.json (Claude Code, Oh My Pi), opencode.json (OpenCode), .codex/config.toml (Codex) in %s\n' "$root"
  printf 'servers: %s\n' "$(for p in $only; do printf 'sim-%s ' "$p"; done)"
  # The repo's needs, committed with the rest; never overwritten, so its edits stay.
  if [ -e "$root/.sim/config" ]; then echo "kept .sim/config"
  else mkdir -p "$root/.sim" && sim_repo_config_template > "$root/.sim/config" || exit 1; echo "wrote .sim/config"; fi
  cat <<EOF

Codex reads .codex/config.toml only in a trusted project: answer yes when Codex asks on its first run in the main
checkout ($(git -C "$root" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')); its worktrees inherit it.
Commit the three files and .sim/config, and add this to the repo's AGENTS.md so every harness knows how to use them:

## Simulators

Three MCP servers drive real devices: \`sim-web\` (headless browser), \`sim-android\` (emulator), \`sim-ios\`
(iOS simulator on a Mac, XcodeBuildMCP). Each holds one device for this session only; \`sim status\` shows them.
Devices start on first use and stop after half an hour unused (the host decides): the next tool call waits for
a boot (up to a minute). An Android emulator starts clean, so after an idle stop run \`sim build\` again.
- Web: \`sim metro start web\` serves the app; open the URL it prints with the sim-web tools.
- Android: \`sim wait\`, then \`sim build\` from the app's directory: it starts Metro for your emulator and builds,
  installs and opens the dev build. Drive it with the sim-android tools; JS edits reach the app without a rebuild.
  Never run \`expo run:android\` yourself: it would build for port 8081, which is not yours.
- Maestro flows: \`sim maestro android test <flows>\` runs them on your emulator, \`sim maestro ios test <flows>\`
  on your iOS simulator, with the app already installed there through the sim-ios tools. Flows and \`--output\`
  paths must lie inside this worktree; reports land at those paths. Each run ends by printing its directory on
  this host (logs, screenshots of a failed step, on Android logcat.txt) and a \`latest\` link to it. Never run
  \`maestro\` directly: it cannot see your device and hangs.
- iOS flows run on the Mac, so a test stack on this host is out of their reach: \`sim maestro ios --forward <p,p>\`
  (or \`sim tunnel ios <p,p> --background\`) makes host 127.0.0.1:<p> reachable there at 127.0.0.1:<p>, with ports
  from \`sim ports ios\`.
- A device or Maestro misbehaving (driver deaths, a stuck emulator): \`sim doctor\` says why. Then
  \`sim maestro android --fresh ...\` resets Maestro's driver; \`sim android restart N\` restarts the emulator cold
  (the app is gone: \`sim build\` again).
- Without a harness session (a script, CI), \`sim lease <android|web|ios>\` holds a slot for this worktree (8 h by
  default, \`--ttl\`) and \`sim release <platform>\` frees it.
- iOS: \`sim ios prepare\` copies this worktree to the Mac and prints its path there; build and run it with the
  sim-ios tools (workspace under that path's ios/ directory), then \`sim metro start ios\`. After a JS-only
  change, \`sim ios sync\` is enough.
- \`sim metro start\` hands Metro every \`EXPO_PUBLIC_*\` variable you have set, plus \`--env K=V\` for others, and
  returns once Metro answers.
EOF
}

cmd_wait() {
  local secs=${1:-180} n
  n=$(my_slot android) || exit 1
  sim_touch android "$n"
  systemctl --user start "$(sim_android_unit "$n")"
  sim_android_wait "$n" "$secs" || die "$(sim_android_serial "$n") did not boot within $secs s (sim android logs $n)"
  echo "$(sim_android_serial "$n") booted"
}

cmd_env() { local n; n=$(my_slot android) || exit 1; sim_android_env "$n"; }

cmd_run() {
  [ $# -gt 0 ] || usage
  local n; n=$(my_slot android) || exit 1
  sim_touch android "$n"
  eval "$(sim_android_env "$n")"
  exec "$@"
}

# sim ports <P> [k|--check]: the slot's port block (lib/sim.sh, sim_port_base). Arguments are checked before the
# lease, so a usage error is rc 2 either way. With `ports = k` in .sim/config, the exports say k ports and list them
# (SIM_PORTS), and --check looks at those k.
cmd_ports() {
  local p=${1:-} arg=${2:-} n base count
  case " $SIM_PLATFORMS " in *" $p "*) [ -n "$p" ] ;; *) false ;; esac || usage
  [ $# -le 2 ] || usage
  case $arg in
    ''|--check) ;;
    *) [[ $arg =~ ^[0-9]{1,3}$ ]] && [ "$((10#$arg))" -ge 1 ] && [ "$((10#$arg))" -le "$SIM_PORT_BLOCK" ] \
         || die "sim ports $p $arg: a count from 1 to $SIM_PORT_BLOCK" 2 ;;
  esac
  repo_cfg
  n=$(my_slot "$p") || exit 1
  read -r base count < <(sim_port_block "$p" "$n")
  count=${SIM_CFG_PORTS:-$count}
  case $arg in
    '') sim_port_env "$p" "$n" ${SIM_CFG_PORTS:+"$SIM_CFG_PORTS"} ;;
    --check) ports_check "$base" "$count" ;;
    *) seq -s ' ' "$base" $((base + 10#$arg - 1)) ;;
  esac
}

# ports_check <base> <count>: one line per listening port of the block, with its process where ss can see it (only
# for this user's processes); rc 1 when any is listening.
ports_check() {
  local base=$1 count=$2 out
  command -v ss >/dev/null || die "ss (iproute2) is not installed, so the ports cannot be checked"
  out=$(ss -Hltnp 2>/dev/null | awk -v lo="$base" -v hi=$((base + count - 1)) '
    { port = $4; sub(/.*:/, "", port); port += 0
      if (port < lo || port > hi) next
      proc = ""; for (i = 6; i <= NF; i++) proc = proc (proc == "" ? "" : " ") $i
      if (!(port in seen) || (seen[port] == "" && proc != "")) seen[port] = proc }
    END { for (p in seen) printf "%s  %s\n", p, (seen[p] == "" ? "(process not visible)" : seen[p]) }' | sort -n)
  if [ -z "$out" ]; then echo "ports $base-$((base + count - 1)): none listening"; return 0; fi
  echo "$out"
  return 1
}

# --- tunnels (sim tunnel ios, sim maestro ios --forward) ---------------------------------------------------------
# On iOS the app, Maestro and its HTTP calls run on the Mac, so a test stack on this host is out of their reach. A
# tunnel is `ssh -N -R` on a connection of its own (a dropped shared master never takes it down): Mac 127.0.0.1:P
# leads to host 127.0.0.1:P. 127.0.0.1 on both sides, never localhost, which tries ::1 first. Remote ports are shared
# by every slot on the Mac, hence the slot's port block (sim ports) and a check for ports already bound there.
# A background tunnel has the pidfile $SIM_STATE/ios/N.tunnel (pid=, ports=, root=, watcher=) and a watcher
# (`sim _tunnel_watch`) that closes it within SIM_TUNNEL_WATCH seconds (10) of the worktree losing its ios lease.

tunnel_file() { echo "$SIM_STATE/ios/$1.tunnel"; }

# tunnel_parse <spec>: "p[,p…]" as ports one per line, each from 1 to 65535, no repeats; rc 2 with a message otherwise.
tunnel_parse() {
  local spec=$1 p seen=' '
  [[ $spec =~ ^[0-9]+(,[0-9]+)*$ ]] || { sim_fail "ports $spec: a comma list of port numbers, e.g. 22000,22001"; return 2; }
  for p in ${spec//,/ }; do
    [ ${#p} -le 5 ] && [ "$((10#$p))" -ge 1 ] && [ "$((10#$p))" -le 65535 ] || { sim_fail "port $p: from 1 to 65535"; return 2; }
    p=$((10#$p)); [[ $seen == *" $p "* ]] && continue
    seen+="$p "; echo "$p"
  done
}

# tunnel_in_block <N> <any> <port...>: every port must lie in ios slot N's block (rc 2 with the hint); with any=1 a
# port outside it is forwarded after a warning.
tunnel_in_block() {
  local n=$1 any=$2 base count p rc=0; shift 2
  read -r base count < <(sim_port_block ios "$n")
  for p; do
    [ "$p" -lt "$base" ] || [ "$p" -ge $((base + count)) ] || continue
    if [ "$any" = 1 ]; then
      echo "sim: warning: port $p is outside ios slot $n's block $base-$((base + count - 1)): another slot may use it too" >&2
    else
      sim_fail "port $p is outside ios slot $n's block $base-$((base + count - 1)) (sim ports ios); --any-port forwards it anyway, at the risk of colliding with another slot" || true
      rc=2
    fi
  done
  return "$rc"
}

# mac_listeners <port...>: "<port> <pid> <command>" for each of the ports something listens on at the Mac, "<port> - -"
# where lsof cannot name it. One ssh call. A port is taken when a connection to 127.0.0.1:<port> succeeds
# (/bin/bash's /dev/tcp, on macOS too): lsof as the runner sees neither other users' processes nor sshd's forward
# listeners, so it only names the holder where it can. lsof at its macOS path first, so PATH on the Mac does not
# matter. "=\$p" is quoted: zsh, the runner's shell, expands an unquoted =word to a command's path. rc 1 when the
# Mac does not answer.
mac_listeners() {
  local out
  out=$(SIM_SSH_TIMEOUT=15 sim_ios_ssh "L=/usr/sbin/lsof; [ -x \$L ] || L=lsof; for p in $*; do echo \"=\$p\"; /bin/bash -c 'exec 3<>/dev/tcp/127.0.0.1/'\$p 2>/dev/null && echo +; \$L -nP \"-iTCP:\$p\" -sTCP:LISTEN -Fpc 2>/dev/null; done; exit 0" </dev/null) \
    || return 1
  awk '/^=/ { port = substr($0, 2); order[++n] = port; pid = ""; next }
       /^\+$/ { open[port] = 1; next }
       /^p/ { pid = substr($0, 2); next }
       /^c/ && pid != "" { if (!seen[port " " pid]++) print port, pid, substr($0, 2); named[port] = 1 }
       END { for (i = 1; i <= n; i++) if (open[order[i]] && !named[order[i]]) print order[i], "-", "-" }' <<<"$out"
}

tunnel_field() { sed -n "s/^$2=//p" "$(tunnel_file "$1")" 2>/dev/null; }   # tunnel_field <N> <key>

tunnel_live() { # tunnel_live <N>: the ports of slot N's background tunnel while its ssh runs; rc 1 when none does
  local pid; pid=$(tunnel_field "$1" pid)
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  tunnel_field "$1" ports
}

# tunnel_start <N> <port...>: check that no port is bound on the Mac, start the forwards and wait until every port
# takes connections on the Mac (SIM_TUNNEL_READY_TIMEOUT, 5 s). Sets TUNNEL_PID; exits 1 when a port is bound or the
# tunnel does not come up, with ssh's stderr. With TUNNEL_DETACH=1 the ssh runs in a session of its own;
# TUNNEL_CLOSE_FD names an fd it must not inherit (a caller's lock).
tunnel_start() {
  local n=$1 bound line p pid cmd mine fwd=() err up i
  shift
  bound=$(mac_listeners "$@") || unavailable "could not check the ports on $AGENT_IOS_HOST"
  if [ -n "$bound" ]; then
    mine=$(tunnel_live "$n" || true)
    while read -r p pid cmd; do
      if [[ ,$mine, == *",$p,"* ]]; then line="port $p already bound on the Mac by this slot's background tunnel (sim tunnel ios --stop)"
      elif [ "$pid" = - ]; then line="port $p already bound on the Mac, by a process lsof does not show the runner (another user's, or an ssh tunnel)"
      else line="port $p already bound on the Mac by $cmd (pid $pid)"; fi
      echo "sim: $line" >&2
    done <<<"$bound"
    exit 1
  fi
  for p; do fwd+=(-R "127.0.0.1:$p:127.0.0.1:$p"); done
  mkdir -p "$SIM_STATE/ios"; err=$SIM_STATE/ios/$n.tunnel.log
  ( [ -z "${TUNNEL_CLOSE_FD:-}" ] || exec {TUNNEL_CLOSE_FD}>&-
    pre=(); [ "${TUNNEL_DETACH:-}" != 1 ] || pre=(setsid)
    exec "${pre[@]}" ssh "${SIM_SSH_SOLO_OPTS[@]}" -N -o ExitOnForwardFailure=yes "${fwd[@]}" "${SIM_SSH_OPTS[@]}" \
      "$AGENT_IOS_USER@$AGENT_IOS_HOST" ) </dev/null >/dev/null 2>"$err" &
  TUNNEL_PID=$!
  for ((i = 0; i < ${SIM_TUNNEL_READY_TIMEOUT:-5} * 5; i++)); do
    kill -0 "$TUNNEL_PID" 2>/dev/null || break
    up=$(mac_listeners "$@" | awk '{ print $1 }' | sort -u | wc -l) || up=0
    if [ "$up" -ge $# ]; then kill -0 "$TUNNEL_PID" 2>/dev/null && return 0; break; fi
    sleep 0.2
  done
  kill "$TUNNEL_PID" 2>/dev/null || true; wait "$TUNNEL_PID" 2>/dev/null || true
  die "the tunnel to $AGENT_IOS_HOST did not come up within ${SIM_TUNNEL_READY_TIMEOUT:-5} s: $(tr '\n' ' ' < "$err")"
}

tunnel_stop() { # tunnel_stop <N>: end slot N's background tunnel and its watcher, print its ports; rc 1 when none ran
  local f pid w i ports
  f=$(tunnel_file "$1"); [ -e "$f" ] || return 1
  pid=$(tunnel_field "$1" pid); w=$(tunnel_field "$1" watcher); ports=$(tunnel_field "$1" ports)
  [[ $w =~ ^[0-9]+$ ]] && kill "$w" 2>/dev/null || true
  if [[ $pid =~ ^[0-9]+$ ]] && kill "$pid" 2>/dev/null; then
    for ((i = 0; i < 30; i++)); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    rm -f "$f"; echo "$ports"; return 0
  fi
  rm -f "$f"; return 1
}

# sim tunnel ios <p[,p…]> [--background|--stop|--any-port]
cmd_tunnel() {
  local p=${1:-} spec='' mode=fore any=0 n ports=() list f
  [ "$p" = ios ] || usage
  shift
  while [ $# -gt 0 ]; do
    case $1 in
      --background) mode=back ;;
      --stop) mode=stop ;;
      --any-port) any=1 ;;
      -*) usage ;;
      *) [ -z "$spec" ] || usage; spec=$1 ;;
    esac
    shift
  done
  if [ "$mode" = stop ]; then
    [ -z "$spec" ] || usage
    n=$(my_slot ios) || exit 1
    if list=$(tunnel_stop "$n"); then echo "tunnel of ios slot $n stopped (ports $list)"
    else echo "no tunnel on ios slot $n: nothing to stop"; fi
    return 0
  fi
  repo_cfg
  spec=${spec:-${SIM_CFG_FORWARD_IOS:-}}   # no ports: forward_ios from .sim/config
  [ -n "$spec" ] || usage
  list=$(tunnel_parse "$spec") || exit 2
  mapfile -t ports <<<"$list"
  sim_mac_require
  n=$(my_slot ios) || exit 1
  tunnel_in_block "$n" "$any" "${ports[@]}" || exit 2
  # One background tunnel per slot. One that shares a port with it fails on the bound-port check, which says so.
  if [ "$mode" = back ] && list=$(tunnel_live "$n"); then
    for p in "${ports[@]}"; do [[ ,$list, == *",$p,"* ]] && list=''; done
    [ -z "$list" ] || die "ios slot $n already has a background tunnel (ports $list): sim tunnel ios --stop, then open one with every port"
  fi
  if [ "$mode" = back ]; then
    TUNNEL_DETACH=1 tunnel_start "$n" "${ports[@]}"
    f=$(tunnel_file "$n")
    printf 'pid=%s\nports=%s\nroot=%s\n' "$TUNNEL_PID" "$(IFS=,; echo "${ports[*]}")" "$(sim_root)" > "$f.$$"
    # Detached, stdio closed: the caller (a harness tool call) returns at once.
    setsid "$REPO/bin/sim" _tunnel_watch "$n" "$TUNNEL_PID" "$(sim_root)" </dev/null >/dev/null 2>&1 &
    printf 'watcher=%s\n' "$!" >> "$f.$$"; mv -f "$f.$$" "$f"
    for p in "${ports[@]}"; do echo "tunnel up: Mac 127.0.0.1:$p -> host 127.0.0.1:$p"; done
    echo "in the background until sim tunnel ios --stop, or until this worktree's ios lease ends"
    return 0
  fi
  tunnel_start "$n" "${ports[@]}"
  # shellcheck disable=SC2064   # expanded now
  trap "kill $TUNNEL_PID 2>/dev/null" EXIT
  trap 'exit 0' INT TERM HUP
  for p in "${ports[@]}"; do echo "tunnel up: Mac 127.0.0.1:$p -> host 127.0.0.1:$p"; done
  echo "until Ctrl-C (--background keeps it without a terminal)"
  wait "$TUNNEL_PID" 2>/dev/null || true
  unavailable "the tunnel to $AGENT_IOS_HOST ended: $(tr '\n' ' ' < "$SIM_STATE/ios/$n.tunnel.log")"
}

# _tunnel_watch <N> <pid> <root>: started by `sim tunnel ios --background`. Ends the tunnel once <root> no longer holds
# ios slot N, and removes the pidfile once the tunnel is gone (unless it names another tunnel by then).
cmd_tunnel_watch() {
  local n=$1 pid=$2 root=$3
  while kill -0 "$pid" 2>/dev/null; do
    if ! { sim_held ios "$n" && [ "$(sim_owner_field ios "$n" root)" = "$root" ]; }; then
      kill "$pid" 2>/dev/null; break
    fi
    sleep "${SIM_TUNNEL_WATCH:-10}"
  done
  [ "$(tunnel_field "$n" pid)" != "$pid" ] || rm -f "$(tunnel_file "$n")"
}

reap_tunnels() { # drop pidfiles of background tunnels whose ssh is gone; close tunnels whose lease has ended
  local n count pid root
  count=$(sim_slots ios)
  for ((n = 1; n <= count; n++)); do
    [ -e "$(tunnel_file "$n")" ] || continue
    pid=$(tunnel_field "$n" pid); root=$(tunnel_field "$n" root)
    if ! [[ $pid =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then rm -f "$(tunnel_file "$n")"; continue; fi
    sim_held ios "$n" && [ "$(sim_owner_field ios "$n" root)" = "$root" ] && continue
    tunnel_stop "$n" >/dev/null && echo "ios $n: tunnel closed, its lease has ended"
  done
  return 0
}

metro_pidfile() { echo "$SIM_STATE/$1/$2.metro"; }

metro_stop_slot() { # metro_stop_slot <android|web> <N>: stop the slot's Metro on the host; true when one ran
  local f pid; f=$(metro_pidfile "$1" "$2")
  pid=$(cat "$f" 2>/dev/null || true); rm -f "$f"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
}

# metro_env [K=V...]: the variables Metro gets, into METRO_ENV (K=V words, for `env`) and METRO_ENV_NAMES: every
# EXPO_PUBLIC_* of the caller's environment, every set name of SIM_METRO_ENV (a comma list; when it is not set, the
# metro_env of .sim/config), then each K=V given (from
# --env), a later one replacing an earlier one of the same name. A name that is not a variable name is rc 2.
METRO_ENV=(); METRO_ENV_NAMES=()
metro_env() {
  local -A val=()
  local kv k pairs=()
  for k in $(compgen -e | grep '^EXPO_PUBLIC_' || true); do pairs+=("$k=${!k}"); done
  local list=${SIM_METRO_ENV-${SIM_CFG_METRO_ENV:-}}
  for k in ${list//,/ }; do
    [[ $k =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "SIM_METRO_ENV: $k is not a variable name" 2
    [ -z "${!k+x}" ] || pairs+=("$k=${!k}")
  done
  for kv; do
    [[ $kv =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "--env $kv: K=V, K a variable name ([A-Za-z_][A-Za-z0-9_]*)" 2
    pairs+=("$kv")
  done
  METRO_ENV=(); METRO_ENV_NAMES=()
  for kv in "${pairs[@]}"; do k=${kv%%=*}; [ -n "${val[$k]+x}" ] || METRO_ENV_NAMES+=("$k"); val[$k]=${kv#*=}; done
  for k in "${METRO_ENV_NAMES[@]}"; do METRO_ENV+=("$k=${val[$k]}"); done
}

# metro_ready_script <port> <log>: a POSIX sh loop (run by bash on the host, by the runner's zsh on the Mac) that asks
# Metro's /status once a second until it says packager-status:running, for SIM_METRO_READY_TIMEOUT seconds (90);
# then it prints the last 20 lines of <log> (a path already quoted for the shell) to stderr and exits 1. It goes by
# the clock, so it ends at most one curl (2 s) after the timeout.
metro_ready_script() {
  local t=${SIM_METRO_READY_TIMEOUT:-90}
  [[ $t =~ ^[0-9]+$ ]] || die "SIM_METRO_READY_TIMEOUT=$t: a number of seconds" 2
  printf '%s\n' "end=\$((\$(date +%s) + $t)); while :; do
  [ \"\$(curl -fs --max-time 2 http://127.0.0.1:$1/status 2>/dev/null)\" = packager-status:running ] && exit 0
  [ \"\$(date +%s)\" -lt \"\$end\" ] || break; sleep 1; done
echo \"sim: Metro on port $1 did not answer within $t s; the end of its log:\" >&2; tail -n 20 $2 >&2; exit 1"
}

# Builds, installs and opens the dev build on this worktree's emulator, served by the slot's Metro, from the app's
# directory (lib/sim.sh, sim_stack_build_android).
cmd_build() {
  local n port pid root app
  repo_cfg
  root=$(sim_root); app=$(app_rel "$root")
  n=$(my_slot android) || exit 1
  port=$(sim_metro_port android "$n")
  sim_touch android "$n"
  systemctl --user start "$(sim_android_unit "$n")"
  sim_android_wait "$n" "${SIM_BOOT_TIMEOUT:-180}" || die "$(sim_android_serial "$n") did not boot (sim android logs $n)"
  pid=$(cat "$(metro_pidfile android "$n")" 2>/dev/null || true)
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then cmd_metro start android; fi
  eval "$(sim_android_env "$n")"
  # Always, not only with a new Metro: an emulator that was restarted since has lost the reverse.
  adb reverse tcp:8081 "tcp:$port" >/dev/null || die "adb reverse tcp:8081 tcp:$port failed on $(sim_android_serial "$n")"
  sim_stack_build_android "$port" "$@" || exit
  cd "$root/$app"
  exec "${SIM_STACK_CMD[@]}" </dev/null
}

# A Maestro run keeps its own directory on the host, $SIM_CACHE/<platform>/maestro-N/runs/<YYYYmmdd-HHMMSS>, with
# debug/ and output/ (where a `test` run's --debug-output and --test-output-dir go unless the caller gave them),
# artifacts/ (iOS: the caller's own output paths, on their way home), cmd.txt (the command and its rc) and, on
# android, logcat.txt. maestro-N/latest links to the newest; only the last AGENT_SIM_KEEP_RUNS are kept.

# maestro_args <root> <args...>: one pass over the arguments of `sim maestro <platform>`. sim's own flags are taken
# out here, before Maestro sees any (add them as cases above the output flags). Maestro's output flags --output,
# --test-output-dir and --debug-output, as `--x P` or `--x=P`, must name a path inside the worktree (rc 2), which is
# made absolute. Sets MA_ARGS (Maestro's arguments), and per argument MA_OUT (the absolute output path it carries,
# else empty) and MA_KEY (`--x=` when the path is in the same argument); MA_GIVEN lists the output flags given.
# sim's own: --forward p[,p…] (iOS) sets MA_FORWARD, --forward none empties it; either sets MA_FORWARD_GIVEN=1.
# --fresh sets MA_FRESH=1, --cold MA_COLD=1.
maestro_args() {
  local root=$1 a p; shift
  MA_ARGS=(); MA_OUT=(); MA_KEY=(); MA_GIVEN=' '; MA_FORWARD=(); MA_FORWARD_GIVEN=; MA_FRESH=0; MA_COLD=0
  while [ $# -gt 0 ]; do
    a=$1; shift
    case $a in
      --forward|--forward=*)   # sim tunnel's ports for the run (iOS): MA_FORWARD
        if [ "$a" = --forward ]; then [ $# -gt 0 ] || usage; p=$1; shift; else p=${a#*=}; fi
        MA_FORWARD_GIVEN=1; MA_FORWARD=()
        [ "$p" = none ] && continue
        p=$(tunnel_parse "$p") || exit 2
        mapfile -t MA_FORWARD <<<"$p" ;;
      --fresh) MA_FRESH=1 ;;   # reset Maestro's driver before the run (maestro_fresh_android, maestro_ios)
      --cold) MA_COLD=1 ;;     # restart the device before the run: android_restart, or a shutdown and boot on iOS
      --output|--test-output-dir|--debug-output)
        [ $# -gt 0 ] || die "$a needs a path" 2
        p=$(maestro_out_path "$root" "$1") || exit; shift
        MA_ARGS+=("$a" "$p"); MA_OUT+=("" "$p"); MA_KEY+=("" ""); MA_GIVEN+="$a " ;;
      --output=*|--test-output-dir=*|--debug-output=*)
        p=$(maestro_out_path "$root" "${a#*=}") || exit
        MA_ARGS+=("${a%%=*}=$p"); MA_OUT+=("$p"); MA_KEY+=("${a%%=*}="); MA_GIVEN+="${a%%=*} " ;;
      *) MA_ARGS+=("$a"); MA_OUT+=(""); MA_KEY+=("") ;;
    esac
  done
}

maestro_out_path() { # maestro_out_path <root> <path>: the path made absolute; it must lie inside the worktree
  local p; p=$(realpath -m -- "$2" 2>/dev/null) || p=
  case $p in "$1"/?*) printf '%s\n' "$p" ;; *) die "output paths must lie inside the worktree $1: $2" 2 ;; esac
}

# maestro_defaults <debug> <output>: MA_PRE, the flags sim adds right after `test` for the output flags not given.
maestro_defaults() {
  MA_PRE=()
  [ "${MA_ARGS[0]:-}" = test ] || return 0
  [[ $MA_GIVEN == *" --debug-output "* ]] || MA_PRE+=(--debug-output "$1")
  [[ $MA_GIVEN == *" --test-output-dir "* ]] || MA_PRE+=(--test-output-dir "$2")
}

# maestro_new_run <base> <platform> <args...>: make the run directory under <base> (maestro-N), point latest at it,
# prune to AGENT_SIM_KEEP_RUNS and write cmd.txt. Sets MR_ID and MR_DIR. Two runs in one second get -2, -3, ...
maestro_new_run() {
  local base=$1 p=$2 id i=1 old; shift 2
  id=$(date +%Y%m%d-%H%M%S); MR_ID=$id
  mkdir -p "$base/runs"
  until mkdir "$base/runs/$MR_ID" 2>/dev/null; do
    i=$((i + 1)); [ "$i" -le 99 ] || die "could not make a run directory in $base/runs"
    MR_ID=$id-$i
  done
  MR_DIR=$base/runs/$MR_ID
  mkdir -p "$MR_DIR/debug" "$MR_DIR/output" "$MR_DIR/artifacts"
  ln -sfn "runs/$MR_ID" "$base/latest"
  find "$base/runs" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort -V | head -n "-$AGENT_SIM_KEEP_RUNS" \
    | while IFS= read -r old; do rm -rf -- "${base:?}/runs/$old"; done
  { printf 'args:'; printf ' %q' sim maestro "$p" "$@"; echo; } > "$MR_DIR/cmd.txt"
}

maestro_end_run() { # maestro_end_run <base> <rc>: the rc into cmd.txt, and where the run is
  echo "rc: $2" >> "$MR_DIR/cmd.txt"
  echo "maestro run $MR_ID: $MR_DIR" >&2
  echo "latest: $1/latest" >&2
}

# Maestro reaches devices only through adb servers on 5037 and 5038 and a direct scan of the emulator ports, where it
# hangs on an emulator its slot's server already holds; ANDROID_ADB_SERVER_PORT means nothing to it. So it runs in a
# container, a network namespace of its own, where both ports lead to this slot's adb server (maestro-entry.sh). The
# host side of that is a relay container on the host network: the slot's adb server on 127.0.0.1:5037+N, offered as
# a unix socket in a directory both containers mount. Paths Maestro is given must lie inside the worktree, which is
# mounted at its own path, and so is its HOME, $SIM_CACHE/android/maestro-N, which holds the run directories: Maestro
# writes its output, and a caller's output paths, in place, and the paths it prints are right on the host too.
maestro_android() {
  [ $# -gt 0 ] || usage
  command -v docker >/dev/null || die "sim maestro needs docker, usable without sudo"
  local n root image name run home ttyf=() envs=() v rc args keep logcat
  root=$(sim_root)
  repo_cfg   # keep_runs
  maestro_args "$root" "$@"
  [ ${#MA_FORWARD[@]} = 0 ] || die "--forward is for iOS: on android, flows reach the host through the docker bridge" 2
  n=$(my_slot android) || exit 1
  image=$(sim_maestro_image); name=agent-sim-maestro-$n
  run=$SIM_STATE/android/$n.maestro; home=$SIM_CACHE/android/maestro-$n
  [ -z "$(docker ps -q --filter "name=^$name\$")" ] || die "a Maestro run is already going on android slot $n"
  sim_touch android "$n"
  if [ "$MA_COLD" = 1 ]; then android_restart "$n" >&2
  else
    systemctl --user start "$(sim_android_unit "$n")"
    sim_android_wait "$n" "${SIM_BOOT_TIMEOUT:-180}" || die "$(sim_android_serial "$n") did not boot (sim android logs $n)"
  fi
  [ "$MA_FRESH" = 0 ] || maestro_fresh_android "$n"
  if ! docker image inspect "$image" >/dev/null 2>&1; then
    echo "sim maestro: building $image, once (downloads Maestro $SIM_MAESTRO_VERSION)" >&2
    docker build -q -t "$image" --build-arg "MAESTRO_VERSION=$SIM_MAESTRO_VERSION" \
      --build-arg "MAESTRO_SHA256=$SIM_MAESTRO_SHA256" -f "$REPO/config/sim/Dockerfile.maestro" "$REPO/config/sim" >/dev/null \
      || die "could not build $image"
  fi
  rm -rf -- "$run"; mkdir -p "$run" "$home"
  maestro_new_run "$home" android "$@"
  maestro_defaults "$MR_DIR/debug" "$MR_DIR/output"
  args=("${MA_ARGS[@]:0:1}" "${MA_PRE[@]}" "${MA_ARGS[@]:1}")
  docker rm -f "$name-adb" >/dev/null 2>&1 || true
  docker run -d --rm --name "$name-adb" --network host --user "$(id -u):$(id -g)" -v "$run:/run/sim" \
    --entrypoint socat "$image" UNIX-LISTEN:/run/sim/adb.sock,fork,mode=600 "TCP:127.0.0.1:$(sim_adb_port "$n")" >/dev/null \
    || die "could not start the adb relay for slot $n"
  # A long suite is use: keep the reaper off the emulator while it runs.
  ( while sleep 60; do sim_touch android "$n"; done ) >/dev/null 2>&1 &
  keep=$!
  # The device log of this run only, for driver deaths that Maestro reports without a cause.
  ( eval "$(sim_android_env "$n")"; adb logcat -c >/dev/null 2>&1 || true; exec adb logcat -v threadtime ) \
    > "$MR_DIR/logcat.txt" 2>&1 &
  logcat=$!
  # shellcheck disable=SC2064   # expanded now: the trap runs after this function's locals are gone
  trap "kill $keep $logcat 2>/dev/null; docker rm -f $name-adb >/dev/null 2>&1" EXIT
  [ -t 0 ] && [ -t 1 ] && ttyf=(-t)
  # Maestro hands MAESTRO_* variables to the flows.
  for v in $(compgen -e | grep '^MAESTRO_' || true); do envs+=(-e "$v"); done
  rc=0
  docker run --rm -i "${ttyf[@]}" --name "$name" --user "$(id -u):$(id -g)" -e "HOME=$home" "${envs[@]}" \
    -v "$run:/run/sim" -v "$home:$home" -v "$root:$root" -w "$(pwd -P)" \
    "$image" "$(sim_android_serial "$n")" "${args[@]}" || rc=$?
  sim_touch android "$n"
  maestro_end_run "$home" "$rc"
  return "$rc"
}

# Maestro's Android driver, confirmed read-only on emulator-5600 on 15 Oct 2026 (Maestro 2.11.0): `pm list packages`
# has dev.mobile.maestro and dev.mobile.maestro.test; while the driver runs, `ps -A` shows a process named
# dev.mobile.maestro, started by a root `app_process` running `am instrument ... dev.mobile.maestro.test/
# androidx.test.runner.AndroidJUnitRunner`. A second UiAutomation client shows as a process named uiautomator (what
# `uiautomator dump` runs as): the documented name, not seen live. Only one client can instrument a device at a time.
MAESTRO_ANDROID_PACKAGES="dev.mobile.maestro dev.mobile.maestro.test"
MAESTRO_ANDROID_CLIENTS='dev\.mobile\.maestro|uiautomator'   # process names (ps -A -o NAME) that instrument the device
# Maestro's iOS driver: the XCTest runner app and its host app on the simulator. The ids are Maestro's documented
# ones, not yet confirmed on the Mac.
MAESTRO_IOS_BUNDLES="dev.mobile.maestro-driver-iosUITests.xctrunner dev.mobile.maestro-driver-ios"

# maestro_fresh_android <N>: stop Maestro's driver on slot N's emulator and any stray uiautomator, without a reboot.
maestro_fresh_android() {
  local p cmd=''
  for p in $MAESTRO_ANDROID_PACKAGES; do cmd+="am force-stop $p; "; done
  ( eval "$(sim_android_env "$1")"; timeout 20 adb shell "${cmd}pkill uiautomator; true" ) >/dev/null 2>&1 || true
  echo "sim maestro: Maestro's driver stopped on $(sim_android_serial "$1"); this run starts a new one" >&2
}

# maestro_ios_launcher: the Mac's sim-maestro must speak contract 2, `sim-maestro <N> <run-id> <args...>`.
maestro_ios_launcher() {
  local v rc=0
  v=$(sim_ios_ssh 'sim-maestro --version' </dev/null 2>/dev/null) || rc=$?
  [ "$rc" != 255 ] || die "could not reach $AGENT_IOS_HOST" 3
  [ "$v" = 2 ] || die "the Mac's sim-maestro is out of date: sim ios bootstrap"
}

# Maestro's iOS driver is an XCTest runner that xcodebuild installs on the simulator, so on iOS Maestro runs on the
# Mac: the launcher sim-maestro (install-ios-runner.sh) runs it on agent-ios-N, in the synced copy of the worktree,
# which every run syncs first. Paths into the worktree are rewritten to the same paths in that copy, so they must lie
# inside the worktree; output paths go to artifacts/<path in the worktree> of the run's directory on the Mac
# (~/.cache/agent-sim/maestro-N/runs/<id>), which comes back to the host's run directory, from where they are copied
# to the paths the caller gave. Maestro picks a free port for its driver on every run, so slots run side by side.
# --forward p[,p…] is sim's own: a tunnel (above) holds those host ports on the Mac for the length of the run.
maestro_ios() {
  [ $# -gt 0 ] || usage
  sim_mac_require
  local n root app lock base mrun a i k words=() envs=() v tty=() rc err p rel src toucher
  root=$(sim_root); app=$(sim_app_rel "$PWD" "$root")   # where sim runs, never app_dir: flow paths are relative to it
  repo_cfg
  maestro_args "$root" "$@"
  [ ${#MA_ARGS[@]} -gt 0 ] || usage
  # forward_ios from .sim/config when --forward is absent. Checked here, before anything runs, as --forward is.
  if [ -z "$MA_FORWARD_GIVEN" ] && [ -n "${SIM_CFG_FORWARD_IOS:-}" ]; then
    a=$(tunnel_parse "$SIM_CFG_FORWARD_IOS") || exit 2
    mapfile -t MA_FORWARD <<<"$a"
  fi
  n=$(my_slot ios) || exit 1
  [ ${#MA_FORWARD[@]} = 0 ] || tunnel_in_block "$n" 0 "${MA_FORWARD[@]}" || exit 2
  base=$SIM_CACHE/ios/maestro-$n
  mkdir -p "$SIM_STATE/ios"
  exec {lock}> "$SIM_STATE/ios/$n.maestro.lock"
  flock -n "$lock" || die "a Maestro run is already going on ios slot $n"
  sim_touch ios "$n"
  maestro_ios_launcher
  cmd_ios sync >/dev/null || die "could not sync $root to $AGENT_IOS_HOST"
  if [ "$MA_COLD" = 1 ]; then   # the app stays installed: a simulator keeps its data across a shutdown
    sim_ios_ssh "xcrun simctl shutdown $(sim_ios_name "$n") 2>/dev/null; true" </dev/null >/dev/null 2>&1 \
      || unavailable "$AGENT_IOS_HOST did not answer"
    echo "sim maestro: $(sim_ios_name "$n") shut down, booting it again (the app stays installed)" >&2
  fi
  sim_ios_boot "$n" || die "could not boot $(sim_ios_name "$n") on $AGENT_IOS_HOST"
  rm -f "$SIM_STATE/ios/$n.down"
  if [ "$MA_FRESH" = 1 ]; then
    local b cmd=''
    for b in $MAESTRO_IOS_BUNDLES; do cmd+="xcrun simctl terminate $(sim_ios_name "$n") $b 2>/dev/null; "; done
    sim_ios_ssh "${cmd}true" </dev/null >/dev/null 2>&1 || unavailable "$AGENT_IOS_HOST did not answer"
    echo "sim maestro: Maestro's driver stopped on $(sim_ios_name "$n"); this run starts a new one" >&2
  fi
  maestro_new_run "$base" ios "$@"
  mrun=.cache/agent-sim/maestro-$n/runs/$MR_ID   # the run's directory on the Mac, under the runner's home
  # A long suite is use: keep the reaper off the simulator while it runs.
  ( exec {lock}>&-; while sleep 60; do sim_touch ios "$n"; done ) >/dev/null 2>&1 &
  toucher=$!
  # shellcheck disable=SC2064   # expanded now: the trap runs after this function's locals are gone
  trap "kill $toucher 2>/dev/null" EXIT
  if [ ${#MA_FORWARD[@]} -gt 0 ]; then
    TUNNEL_CLOSE_FD=$lock tunnel_start "$n" "${MA_FORWARD[@]}"
    # shellcheck disable=SC2064
    trap "kill $toucher $TUNNEL_PID 2>/dev/null" EXIT
    for a in "${MA_FORWARD[@]}"; do echo "tunnel up: Mac 127.0.0.1:$a -> host 127.0.0.1:$a" >&2; done
  fi
  # Words for the remote shell: output paths to the run's artifacts/, other worktree paths into the synced copy.
  for i in "${!MA_ARGS[@]}"; do
    a=${MA_ARGS[i]}
    if [ -n "${MA_OUT[i]}" ]; then
      k=${MA_KEY[i]}; [ -z "$k" ] || k=$(printf %q "$k")
      words+=("$k\"\$HOME\"/$(printf %q "$mrun/artifacts/${MA_OUT[i]#"$root"/}")")
      continue
    fi
    k=; case $a in --*=*) k=${a%%=*}=; a=${a#*=} ;; esac
    case $a in "$root"/*) a=$(realpath -m -s --relative-to="$root/$app" "$a") ;; esac
    words+=("$(printf %q "$k$a")")
  done
  maestro_defaults "\"\$HOME\"/$mrun/debug" "\"\$HOME\"/$mrun/output"
  words=("${words[@]:0:1}" "${MA_PRE[@]}" "${words[@]:1}")
  # Maestro hands MAESTRO_* variables to the flows.
  for v in $(compgen -e | grep '^MAESTRO_' || true); do envs+=("$(printf %q "$v=${!v}")"); done
  [ -t 0 ] && [ -t 1 ] && tty=(-tt)
  rc=0
  sim_ios_ssh "${tty[@]}" "cd $(sim_mac_dir "$root" "$app") && env ${envs[*]} sim-maestro $n $MR_ID ${words[*]}" || rc=$?
  sim_touch ios "$n"
  # This run's directory only, and no --delete: the host keeps its own runs, the Mac only its last few.
  if err=$(rsync -az -e "ssh ${SIM_SSH_OPTS[*]}" "$AGENT_IOS_USER@$AGENT_IOS_HOST:$mrun/" "$MR_DIR/" 2>&1 >/dev/null); then
    for p in "${MA_OUT[@]}"; do
      [ -n "$p" ] || continue
      rel=${p#"$root"/}; src=$MR_DIR/artifacts/$rel
      if [ -d "$src" ]; then
        mkdir -p "$p" && cp -a "$src/." "$p/" || echo "sim maestro: could not copy $rel into the worktree" >&2
      elif [ -e "$src" ]; then
        mkdir -p "$(dirname "$p")" && cp -a "$src" "$p" || echo "sim maestro: could not copy $rel into the worktree" >&2
      else
        echo "sim maestro: Maestro wrote nothing to $rel" >&2
      fi
    done
  else
    echo "sim maestro: could not fetch run $MR_ID from $AGENT_IOS_HOST:" >&2
    printf '%s\n' "$err" >&2
  fi
  maestro_end_run "$base" "$rc"
  return "$rc"
}

cmd_maestro() {
  local p=${1:-}; [ $# -gt 0 ] && shift
  case $p in
    android) maestro_android "$@" ;;
    ios) maestro_ios "$@" ;;
    *) usage ;;
  esac
}

# sim metro start <P> [--env K=V]...: Metro for the slot, with the variables metro_env collects; returns once Metro
# answers on /status (metro_ready_script), rc 1 with the end of its log when it does not.
cmd_metro() {
  local action=${1:-} p=${2:-} n port root log app envs=() ready
  case $p in android|web|ios) shift 2 ;; *) usage ;; esac
  while [ $# -gt 0 ]; do
    case $action:$1 in
      start:--env) [ $# -ge 2 ] || usage; envs+=("$2"); shift 2 ;;
      start:--env=*) envs+=("${1#--env=}"); shift ;;
      *) usage ;;
    esac
  done
  repo_cfg
  [ "$action" != start ] || metro_env "${envs[@]}"
  [ "$p" != ios ] || sim_mac_require
  n=$(my_slot "$p"); port=$(sim_metro_port "$p" "$n"); root=$(sim_root)
  [ "$action" != start ] || sim_touch "$p" "$n"
  log=$SIM_STATE/$p/$n.metro.log
  app=$(app_rel "$root")
  case $action in
    start)
      if [ "$p" = web ]; then sim_stack_metro_cmd "$port" --web; else sim_stack_metro_cmd "$port"; fi || exit
      local names; printf -v names '%s, ' "${METRO_ENV_NAMES[@]}"
      [ ${#METRO_ENV_NAMES[@]} = 0 ] || echo "env: ${names%, }"
      if [ "$p" = ios ]; then
        local dir q=() w rc=0; dir=$(sim_mac_dir "$root" "$app")
        for w in env "${METRO_ENV[@]}" "${SIM_STACK_CMD[@]}"; do q+=("$(printf %q "$w")"); done
        sim_ios_ssh "cd $dir && (pkill -f 'expo start.*--port $port' || true); nohup ${q[*]} > .metro.log 2>&1 < /dev/null & echo started" >/dev/null \
          || unavailable "could not start Metro on $AGENT_IOS_HOST"
        echo "Metro on the Mac in ~/$(sim_mac_path "$root" "$app"), port $port (log: sim metro log ios)"
        [ "$port" = 8081 ] || echo "a debug build finds it only when built with extraArgs [\"RCT_METRO_PORT=$port\"]"
        # One ssh for the whole wait; timeout ends it should the Mac stop answering halfway.
        ready=$(metro_ready_script "$port" "$dir/.metro.log")
        SIM_SSH_TIMEOUT=$((${SIM_METRO_READY_TIMEOUT:-90} + 15)) sim_ios_ssh "$ready" </dev/null || rc=$?
        case $rc in
          0) echo "Metro ready on port $port" ;;
          1) exit 1 ;;
          *) unavailable "$AGENT_IOS_HOST stopped answering while Metro started (rc $rc)" ;;
        esac
        return
      fi
      cmd_metro stop "$p" >/dev/null 2>&1 || true
      # Not CI=1: that turns off Metro's file watching, and an agent's edit would never reach the device. With stdin
      # from /dev/null Expo is non-interactive anyway.
      (cd "$root/$app" || exit 1
       BROWSER=none setsid nohup env "${METRO_ENV[@]}" "${SIM_STACK_CMD[@]}" > "$log" 2>&1 < /dev/null & echo $! > "$(metro_pidfile "$p" "$n")") || exit 1
      if [ "$p" = android ]; then
        eval "$(sim_android_env "$n")"
        # A default dev build asks for localhost:8081 on the device; send that to this slot's Metro on the host.
        adb reverse tcp:8081 "tcp:$port" >/dev/null || echo "adb reverse failed: is the emulator up? (sim wait)" >&2
        echo "Metro on port $port, reachable from $(sim_android_serial "$n") as localhost:8081 (log: $log)"
      else
        echo "Expo web on http://localhost:$port (log: $log)"
      fi
      bash -c "$(metro_ready_script "$port" "$(printf %q "$log")")" || exit 1
      echo "Metro ready on port $port"
      ;;
    stop)
      if [ "$p" = ios ]; then sim_ios_ssh "pkill -f 'expo start.*--port $port' || true"; return; fi
      metro_stop_slot "$p" "$n" || true
      ;;
    log)
      if [ "$p" = ios ]; then sim_ios_ssh "tail -n 100 $(sim_mac_dir "$root" "$app")/.metro.log"; else tail -n 100 "$log"; fi
      ;;
    *) usage ;;
  esac
}

slots_of() { # slots_of <platform> <N|all>
  local count; count=$(sim_slots "$1")
  if [ "$2" = all ]; then seq 1 "$count"
  else [[ $2 =~ ^[1-9]$ ]] && [ "$2" -le "$count" ] || die "no $1 slot $2" 2; echo "$2"; fi
}

cmd_android() {
  local action=${1:-} which=${2:-} n
  case $action in
    start|stop) [ -n "$which" ] || usage
      local slots; slots=$(slots_of android "$which") || exit
      for n in $slots; do
        [ "$action" = stop ] || sim_touch android "$n"
        systemctl --user "$action" "$(sim_android_unit "$n")"
      done ;;
    restart) [ -n "$which" ] || usage
      local slots; slots=$(slots_of android "$which") || exit
      for n in $slots; do android_restart "$n"; done ;;
    logs) [ -n "$which" ] || usage; journalctl --user -u "agent-sim-android@$which.service" -n 100 --no-pager ;;
    # The unit's ExecStart: the slot's own adb server, then the emulator registered with it alone.
    run) [ -n "$which" ] || usage
      eval "$(sim_android_env "$which")"
      # -read-only keeps the instance's writes in qcow2 overlays under ANDROID_TMP, by default /tmp: often RAM, and
      # left there when the emulator crashes (1.5 GB each). One directory per slot on disk, emptied at every start.
      export ANDROID_TMP=$SIM_CACHE/android/$which
      rm -rf -- "$ANDROID_TMP"; mkdir -p "$ANDROID_TMP"
      adb start-server
      exec emulator -avd "$SIM_AVD" -read-only -port "$(sim_android_port "$which")" -no-window -no-audio \
        -no-boot-anim -gpu swiftshader_indirect -no-snapshot-save ;;
    *) usage ;;
  esac
}

# mobilecli_stop <N>: stop slot N's mobilecli daemon (mobile-mcp's), which holds a connection to the adb server that
# the emulator unit takes down with it; mobile-mcp starts a new one on its next call.
mobilecli_stop() {
  MOBILECLI_HOME=$SIM_STATE/android/$1.mobilecli "$SIM_PREFIX/node_modules/.bin/mobilecli" daemon stop </dev/null >/dev/null 2>&1 || true
}

# android_restart <N>: a cold restart of slot N's emulator (it starts from the clean image, so the app is gone). Exit 3
# when it does not boot in time.
android_restart() {
  local n=$1 unit; unit=$(sim_android_unit "$1")
  sim_touch android "$n"
  systemctl --user stop "$unit" || die "could not stop $unit"
  mobilecli_stop "$n"
  systemctl --user start "$unit" || die "could not start $unit (sim android logs $n)"
  sim_android_wait "$n" "${SIM_BOOT_TIMEOUT:-180}" \
    || unavailable "$(sim_android_serial "$n") did not boot within ${SIM_BOOT_TIMEOUT:-180} s (sim android logs $n)"
  echo "$(sim_android_serial "$n") restarted cold; the app is gone, run sim build"
}

# --- sim doctor ------------------------------------------------------------------------------------------------
# Read-only: it starts, stops, boots and touches nothing (a check is not use), and asks a device only while its unit
# is active, since adb would start a server of its own on the slot's port. Each check waits at most
# SIM_DOCTOR_TIMEOUT seconds (10; the Mac's batch of checks three times that), so a hung adb or ssh cannot hang it.
# Every line goes through doctor_line, the one place that prints one (sim doctor --json hooks in there).
DOC_FAIL=0
doctor_line() { # doctor_line <ok|warn|fail> <platform|host> <N|-> <check> <detail>
  [ "$1" != fail ] || DOC_FAIL=1
  printf '%-4s  %-7s %s  %-14s %s\n' "$1" "$2" "$3" "$4" "$5"
}

doc_dur() { # doc_dur <secs>: 2d3h, 3h12m, 12m or 45s
  local s=$1
  if [ "$s" -ge 86400 ]; then echo "$((s / 86400))d$((s % 86400 / 3600))h"
  elif [ "$s" -ge 3600 ]; then echo "$((s / 3600))h$((s % 3600 / 60))m"
  elif [ "$s" -ge 60 ]; then echo "$((s / 60))m"; else echo "${s}s"; fi
}
doc_gb() { awk -v k="$1" 'BEGIN { printf "%.1f", k / 1048576 }'; }   # doc_gb <KiB>: GB with one decimal
doc_ms() { echo $((($(date +%s%N) - $1) / 1000000)); }                 # doc_ms <start in ns>: ms since

doc_adb() { # doc_adb <args...>: adb on the slot's server and emulator (DOC_ENV), cut off after the check timeout
  ( eval "$DOC_ENV"; timeout "$DOC_TO" adb "$@" ) 2>/dev/null
}

# doctor_host: memory, load and disk for the emulators and browsers. SIM_PROC (/proc) is a seam for the tests.
doctor_host() {
  local proc=${SIM_PROC:-/proc} kb load cores dir lvl
  kb=$(awk '/^MemAvailable:/ {print $2}' "$proc/meminfo" 2>/dev/null) || true
  if [[ $kb =~ ^[0-9]+$ ]]; then
    lvl=ok; [ "$kb" -ge 3145728 ] || lvl=warn; [ "$kb" -ge 1048576 ] || lvl=fail
    doctor_line "$lvl" host - memory "$(doc_gb "$kb") GB available"
  else doctor_line warn host - memory "MemAvailable not found in $proc/meminfo"; fi
  read -r load _ < "$proc/loadavg" 2>/dev/null || load=
  cores=$(nproc)
  if [ -n "$load" ]; then
    lvl=ok; awk -v l="$load" -v c="$cores" 'BEGIN { exit !(l > c) }' && lvl=warn
    doctor_line "$lvl" host - load "$load on $cores cores"
  fi
  dir=$SIM_CACHE; while [ ! -d "$dir" ]; do dir=$(dirname "$dir"); done
  kb=$(timeout "$DOC_TO" df -Pk "$dir" 2>/dev/null | awk 'NR == 2 {print $4}') || true
  if [[ $kb =~ ^[0-9]+$ ]]; then
    lvl=ok; [ "$kb" -ge 10485760 ] || lvl=warn; [ "$kb" -ge 2097152 ] || lvl=fail
    doctor_line "$lvl" host - disk "$(doc_gb "$kb") GB free for $SIM_CACHE"
  else doctor_line warn host - disk "df did not answer for $dir"; fi
}

doctor_android() {
  local n=$1 unit st show since nr t0 ms out rc names count pid f base runs r d c dn=0 cn=0 drun=0 crun=0 last=''
  unit=$(sim_android_unit "$n")
  st=$(timeout "$DOC_TO" systemctl --user is-active "$unit" 2>/dev/null) || true
  show=$(timeout "$DOC_TO" systemctl --user show -p ActiveEnterTimestamp -p NRestarts "$unit" 2>/dev/null) || true
  since=$(sed -n 's/^ActiveEnterTimestamp=//p' <<<"$show"); nr=$(sed -n 's/^NRestarts=//p' <<<"$show")
  case $st in
    active)
      since=$(date -d "$since" +%s 2>/dev/null) && since=", up $(doc_dur $(($(date +%s) - since)))" || since=
      doctor_line ok android "$n" unit "active$since" ;;
    activating|reloading) doctor_line warn android "$n" unit "$st: still starting" ;;
    failed) doctor_line fail android "$n" unit "failed (sim android logs $n)" ;;
    *) doctor_line ok android "$n" unit "${st:-inactive}: stopped while unused, the next tool call starts it" ;;
  esac
  if [[ $nr =~ ^[0-9]+$ ]]; then
    if [ "$nr" -gt 0 ]; then doctor_line warn android "$n" restarts "$nr: systemd restarted the emulator after it ended (sim android logs $n)"
    else doctor_line ok android "$n" restarts 0; fi
  fi
  if [ "$st" = active ]; then
    DOC_ENV=$(sim_android_env "$n")
    rc=0; out=$(doc_adb shell getprop sys.boot_completed | tr -d '\r') || rc=$?
    if [ "$rc" = 124 ]; then doctor_line fail android "$n" boot "adb did not answer within $DOC_TO s (sim android restart $n)"
    elif [ "$out" = 1 ]; then doctor_line ok android "$n" boot "sys.boot_completed=1"
    else doctor_line fail android "$n" boot "sys.boot_completed=${out:-nothing}: booting, or stuck (sim android restart $n)"; fi
    t0=$(date +%s%N); rc=0; doc_adb shell true >/dev/null || rc=$?; ms=$(doc_ms "$t0")
    if [ "$rc" != 0 ]; then doctor_line fail android "$n" adb "adb shell true failed (rc $rc) after $ms ms"
    elif [ "$ms" -gt 5000 ]; then doctor_line fail android "$n" adb "round trip $ms ms (over 5 s)"
    elif [ "$ms" -gt 500 ]; then doctor_line warn android "$n" adb "round trip $ms ms (over 500 ms)"
    else doctor_line ok android "$n" adb "round trip $ms ms"; fi
    rc=0; out=$(doc_adb shell ps -A -o NAME) || rc=$?
    if [ "$rc" != 0 ]; then doctor_line warn android "$n" instrumentation "ps -A failed (rc $rc)"
    else
      names=$(tr -d '\r' <<<"$out" | grep -xE "$MAESTRO_ANDROID_CLIENTS" | paste -sd' ' || true)
      count=$(wc -w <<<"$names")
      if [ "$count" -gt 1 ]; then doctor_line warn android "$n" instrumentation "$count clients: $names; only one can drive the device (sim maestro android --fresh)"
      else doctor_line ok android "$n" instrumentation "${names:-none}"; fi
    fi
  fi
  f=$SIM_STATE/android/$n.mobilecli/daemon.pid
  pid=$(sed -n 's/.*"pid": *\([0-9]*\).*/\1/p' "$f" 2>/dev/null) || true
  if [ -z "$pid" ]; then doctor_line ok android "$n" mobilecli "no daemon (mobile-mcp starts one on its first call)"
  elif kill -0 "$pid" 2>/dev/null; then doctor_line ok android "$n" mobilecli "daemon pid $pid"
  else doctor_line warn android "$n" mobilecli "daemon pid $pid is gone (stale $f)"; fi
  # The last AGENT_SIM_KEEP_RUNS Maestro runs: driver deaths in Maestro's logs, crashes and kills in the device log.
  base=$SIM_CACHE/android/maestro-$n/runs
  runs=$(find "$base" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -V | tail -n "$AGENT_SIM_KEEP_RUNS" || true)
  for r in $runs; do
    d=$(grep -rhcE 'DeviceServerDiedException|Device server died' --exclude=logcat.txt "$base/$r" 2>/dev/null | awk '{s += $1} END {print s + 0}' || true)
    c=$(grep -cE 'FATAL EXCEPTION|lowmemorykiller|am_crash' "$base/$r/logcat.txt" 2>/dev/null) || c=0
    [ "$d" = 0 ] || { dn=$((dn + d)); drun=$((drun + 1)); last=$r; }
    [ "$c" = 0 ] || { cn=$((cn + c)); crun=$((crun + 1)); }
  done
  count=$(wc -w <<<"$runs")
  if [ "$count" = 0 ]; then doctor_line ok android "$n" driver-deaths "no Maestro runs kept"
  elif [ "$dn" -gt 0 ]; then doctor_line warn android "$n" driver-deaths "$dn in $drun of the last $count runs, latest in $base/$last (sim maestro android --fresh)"
  else doctor_line ok android "$n" driver-deaths "none in the last $count runs"; fi
  if [ "$count" != 0 ]; then
    if [ "$cn" -gt 0 ]; then doctor_line warn android "$n" device-crashes "$cn FATAL EXCEPTION/lowmemorykiller/am_crash lines in the logcat.txt of $crun of the last $count runs"
    else doctor_line ok android "$n" device-crashes "none in the last $count runs"; fi
  fi
}

# doctor_web <N>: the browsers Playwright MCP's own playwright expects, by the install locations it names.
DOC_WEB=''
doctor_web() {
  local pw=$SIM_PREFIX/node_modules/.bin/playwright out d missing='' have=''
  if [ -z "$DOC_WEB" ]; then
    if [ ! -x "$pw" ]; then DOC_WEB="fail|Playwright is not installed under $SIM_PREFIX (install-host.sh)"
    elif ! out=$(timeout "$DOC_TO" "$pw" install --dry-run chromium webkit 2>/dev/null); then DOC_WEB="fail|playwright install --dry-run failed"
    else
      while IFS= read -r d; do
        if [ -d "$d" ]; then have+="${have:+, }${d##*/}"; else missing+="${missing:+, }${d##*/}"; fi
      done < <(sed -n 's/^ *Install location: *//p' <<<"$out")
      if [ -n "$missing" ]; then DOC_WEB="fail|missing $missing (install-host.sh)"
      elif [ -n "$have" ]; then DOC_WEB="ok|$have"
      else DOC_WEB="fail|playwright names no browsers"; fi
    fi
  fi
  doctor_line "${DOC_WEB%%|*}" web "$1" browsers "${DOC_WEB#*|}"
}

# The Mac's side of the ios checks, one ssh for every slot. Runs in the runner's zsh, POSIX sh syntax only.
DOC_MAC_SCRIPT=$(cat <<'EOF'
echo "launcher=$(sim-maestro --version 2>/dev/null)"
echo "xcodebuildmcp=$(xcodebuildmcp --version 2>/dev/null | tail -1)"
echo "maestro=$(maestro --version 2>/dev/null | tail -1)"
echo "runtime=$(xcrun simctl list runtimes available 2>/dev/null | awk '/^iOS / {r = $1 " " $2} END {print r}')"
echo "disk=$(df -Pk "$HOME" | awk 'NR == 2 {print $4}')"
xcrun simctl list devices 2>/dev/null | sed -n 's/^ *\(agent-ios-[0-9]*\) (.*) (\([A-Za-z ]*\)) *$/device=\1 \2/p'
EOF
)
DOC_MAC=''; DOC_MAC_RC=''; DOC_MAC_MS=''; DOC_MAC_OUT=''
doc_mac_field() { sed -n "s/^$1=//p" <<<"$DOC_MAC_OUT" | head -1; }

doctor_ios() {
  local n=$1 rc t0 v name st kb pid ports
  if [ -z "$DOC_MAC" ]; then
    t0=$(date +%s%N); rc=0; sim_mac_probe --fresh || rc=$?; DOC_MAC_MS=$(doc_ms "$t0")
    case $rc in 0) DOC_MAC=up ;; 2) DOC_MAC=none ;; *) DOC_MAC=down ;; esac
    if [ "$DOC_MAC" = up ]; then
      DOC_MAC_RC=0
      DOC_MAC_OUT=$(SIM_SSH_TIMEOUT=$((DOC_TO * 3)) sim_ios_ssh "$DOC_MAC_SCRIPT" </dev/null 2>/dev/null) || DOC_MAC_RC=$?
    fi
  fi
  case $DOC_MAC in
    none) doctor_line fail ios "$n" mac "AGENT_IOS_HOST and AGENT_IOS_USER are not set in .env"; return ;;
    down) doctor_line fail ios "$n" mac "unreachable: $AGENT_IOS_USER@$AGENT_IOS_HOST did not answer within ${SIM_MAC_PROBE_TIMEOUT:-5} s"; return ;;
  esac
  doctor_line ok ios "$n" mac "$AGENT_IOS_HOST up, answered in $DOC_MAC_MS ms"
  if [ "$DOC_MAC_RC" != 0 ]; then
    doctor_line fail ios "$n" checks "the checks on the Mac did not finish within $((DOC_TO * 3)) s (rc $DOC_MAC_RC)"; return
  fi
  v=$(doc_mac_field launcher)
  case $v in
    2) doctor_line ok ios "$n" launcher "sim-maestro contract 2" ;;
    '') doctor_line fail ios "$n" launcher "no sim-maestro on the Mac: sim ios bootstrap" ;;
    *) doctor_line fail ios "$n" launcher "sim-maestro contract $v, sim needs 2: sim ios bootstrap" ;;
  esac
  for name in xcodebuildmcp:$SIM_XCODEBUILDMCP_VERSION maestro:$SIM_MAESTRO_VERSION; do
    v=$(doc_mac_field "${name%%:*}")
    if [ -z "$v" ]; then doctor_line fail ios "$n" "${name%%:*}" "not installed: sim ios bootstrap"
    elif [ "$v" = "${name#*:}" ]; then doctor_line ok ios "$n" "${name%%:*}" "$v"
    else doctor_line warn ios "$n" "${name%%:*}" "$v, pinned ${name#*:}: sim ios bootstrap"; fi
  done
  v=$(doc_mac_field runtime)
  if [ -n "$v" ]; then doctor_line ok ios "$n" runtime "$v"
  else doctor_line fail ios "$n" runtime "no iOS simulator runtime: an admin installs one (Xcode > Settings > Components)"; fi
  st=$(sed -n "s/^device=$(sim_ios_name "$n") //p" <<<"$DOC_MAC_OUT" | head -1)
  case $st in
    '') doctor_line fail ios "$n" simulator "no $(sim_ios_name "$n") on the Mac: sim ios bootstrap" ;;
    Booted|Shutdown) doctor_line ok ios "$n" simulator "$(sim_ios_name "$n") $st" ;;
    *) doctor_line warn ios "$n" simulator "$(sim_ios_name "$n") $st" ;;
  esac
  kb=$(doc_mac_field disk)
  if ! [[ $kb =~ ^[0-9]+$ ]]; then doctor_line warn ios "$n" disk "df gave no answer on the Mac"
  elif [ "$kb" -lt 15728640 ]; then doctor_line warn ios "$n" disk "$(doc_gb "$kb") GB free, under 15 GB (sim ios gc)"
  else doctor_line ok ios "$n" disk "$(doc_gb "$kb") GB free"; fi
  # A background tunnel (sim tunnel ios --background), if any.
  if [ -e "$(tunnel_file "$n")" ]; then
    pid=$(tunnel_field "$n" pid) || true
    if ports=$(tunnel_live "$n"); then doctor_line ok ios "$n" tunnel "ports $ports, pid $pid"
    else doctor_line warn ios "$n" tunnel "pidfile for ports $(tunnel_field "$n" ports) but pid ${pid:-?} is gone (sim reap removes it)"; fi
  fi
}

# sim doctor [P] [N|all]: no arguments, this worktree's leased slots on every platform; P alone, its slot on P;
# all, every slot. rc 1 when any line is fail.
cmd_doctor() {
  local p=${1:-} which=${2:-} plats n list=() pn
  [ $# -le 2 ] || usage
  case $p in
    all) [ -z "$which" ] || usage; plats=$SIM_PLATFORMS; which=all ;;
    android|web|ios) plats=$p ;;
    '') plats=$SIM_PLATFORMS ;;
    *) usage ;;
  esac
  DOC_TO=${SIM_DOCTOR_TIMEOUT:-10}
  [[ $DOC_TO =~ ^[1-9][0-9]*$ ]] || die "SIM_DOCTOR_TIMEOUT=$DOC_TO: a number of seconds" 2
  for pn in $plats; do
    if [ -n "$which" ]; then
      local slots; slots=$(slots_of "$pn" "$which") || exit
      for n in $slots; do list+=("$pn:$n"); done
    elif n=$(sim_my_slot "$pn"); then list+=("$pn:$n"); fi
  done
  [ ${#list[@]} -gt 0 ] || die "no slot is leased for $(sim_root) (sim doctor all checks every slot)"
  case " ${list[*]}" in *" android:"*|*" web:"*) doctor_host ;; esac
  for pn in "${list[@]}"; do "doctor_${pn%%:*}" "${pn#*:}"; done
  [ "$DOC_FAIL" = 0 ]
}

cmd_ios() {
  local action=${1:-} root tree app
  case $action in start|stop|sync|prepare|bootstrap|gc) sim_mac_require ;; *) usage ;; esac
  case $action in sync|prepare) repo_cfg ;; esac   # the stack's rsync rules and prepare command, app_dir
  root=$(sim_root); app=$(app_rel "$root")
  tree=$(sim_mac_dir "$root")    # sims/<tree>: quoted for the remote shell, the app's directory with sim_mac_dir
  case $action in
    start|stop)
      local n slots; [ -n "${2:-}" ] || usage
      slots=$(slots_of ios "$2") || exit
      for n in $slots; do
        if [ "$action" = start ]; then
          sim_touch ios "$n"
          sim_ios_boot "$n" || die "could not boot $(sim_ios_name "$n") on $AGENT_IOS_HOST"
          rm -f "$SIM_STATE/ios/$n.down"; echo "$(sim_ios_name "$n") booted"
        else
          sim_ios_shutdown "$n" || unavailable "$AGENT_IOS_HOST did not answer"
          mkdir -p "$SIM_STATE/ios"; touch "$SIM_STATE/ios/$n.down"; rm -f "$SIM_STATE/ios/$n.booted"; echo "$(sim_ios_name "$n") shut down"
        fi
      done ;;
    sync)
      # The stamp goes first: sim ios gc keeps a tree whose stamp is recent, so a sync that is still running is safe.
      sim_ios_ssh "mkdir -p $tree && touch $tree/$SIM_SYNC_STAMP" || exit 1
      local args; mapfile -t args < <(sim_rsync_args)
      # The destination is sims/<tree>, which has no character a remote shell splits or expands (sim_tree_name), so it
      # needs neither -s/--protect-args (3.2.3 and older) nor the escaping 3.2.4+ does by default; a space in the root
      # is only ever on the host side. That keeps the Mac's rsync free to be anything that speaks rsync's protocol:
      # Apple's rsync 2.6.9, openrsync (macOS 15+) or Homebrew's 3.x.
      rsync "${args[@]}" -e "ssh ${SIM_SSH_OPTS[*]}" "$root/" "$AGENT_IOS_USER@$AGENT_IOS_HOST:$tree/"
      echo "synced to $(sim_ios_ssh 'echo $HOME')/$(sim_mac_path "$root" "$app") on the Mac" ;;
    prepare)
      # Run from the app's directory (a monorepo's client/): the whole worktree goes over, the app is built there.
      cmd_ios sync
      sim_ios_ssh "cd $(sim_mac_dir "$root" "$app") && $(sim_stack_ios_prepare_cmd)" \
        || die "prepare failed on the Mac; the output above says where"
      echo "workspace: $(sim_ios_ssh "ls -d \$HOME/$(sim_mac_dir "$root" "$app")/ios/*.xcworkspace" | head -1)" ;;
    bootstrap)
      sim_ios_ssh "SIM_XCODEBUILDMCP_VERSION=$SIM_XCODEBUILDMCP_VERSION SIM_MAESTRO_VERSION=$SIM_MAESTRO_VERSION SIM_MAESTRO_SHA256=$SIM_MAESTRO_SHA256 SIM_IOS_SLOTS=$AGENT_SIM_IOS_SLOTS SIM_IOS_DEVICE_TYPE=$SIM_IOS_DEVICE_TYPE SIM_IOS_WORKFLOWS=$SIM_IOS_WORKFLOWS /bin/bash -s" \
        < "$REPO/install-ios-runner.sh" ;;
    gc)
      local days=${2:-7}
      [[ $days =~ ^[0-9]+$ ]] || usage
      # A synced tree goes when its sync stamp is older than N days; one without a stamp (made before stamps, or by an
      # older sim) by its own mtime. Then Xcode's DerivedData, XcodeBuildMCP's own per-workspace DerivedData and
      # Maestro's debug output, by mtime. No globs: the runner's zsh fails a command on a glob that matches nothing.
      local trees="[ -d sims ] && find sims -mindepth 1 -maxdepth 1 -type d | while IFS= read -r t; do s=\$t/$SIM_SYNC_STAMP
        [ -e \"\$s\" ] || s=\$t; [ -n \"\$(find \"\$s\" -prune -mtime +$days)\" ] && echo \"\$t\" && rm -rf \"\$t\"; done"
      sim_ios_ssh "$trees; for d in Library/Developer/Xcode/DerivedData Library/Developer/XcodeBuildMCP/workspaces .cache/agent-sim; do [ -d \$d ] && find \$d -mindepth 1 -maxdepth 1 -type d -mtime +$days -print -exec rm -rf {} + ; done; df -h \$HOME | tail -1" ;;
    *) usage ;;
  esac
}

# --- CLI leases (sim lease, sim release) ------------------------------------------------------------------------
# A CLI lease is held by a detached `sim _hold`, which takes the lock as sim-mcp does and then sleeps with it until
# the lease ends: `sim release` kills it, `sim reap` kills it once its time is up, and it ends by itself then anyway.

lease_kind() { local k; k=$(sim_owner_field "$1" "$2" kind); echo "${k:-mcp}"; }   # owner files before kind= are mcp

at_time() { # at_time <epoch>: HH:MM today, else DD Mon HH:MM
  if [ "$(date -d "@$1" +%F)" = "$(date +%F)" ]; then date -d "@$1" +%H:%M; else date -d "@$1" '+%d %b %H:%M'; fi
}

lease_state() { # lease_state <platform> <N>: the state column of sim status
  sim_held "$1" "$2" || { echo free; return; }
  case $(lease_kind "$1" "$2") in
    cli) echo "leased cli until $(at_time "$(sim_owner_field "$1" "$2" until)") $(sim_owner_field "$1" "$2" root)" ;;
    *)   echo "leased mcp pid $(sim_owner_field "$1" "$2" pid) $(sim_owner_field "$1" "$2" root)" ;;
  esac
}

reap_leases() { # end every CLI lease whose time is up
  local p n count until pid
  for p in $SIM_PLATFORMS; do
    count=$(sim_slots "$p")
    for ((n = 1; n <= count; n++)); do
      sim_held "$p" "$n" && [ "$(lease_kind "$p" "$n")" = cli ] || continue
      until=$(sim_owner_field "$p" "$n" until); pid=$(sim_owner_field "$p" "$n" pid)
      [[ $until =~ ^[0-9]+$ ]] && [ "$until" -le "$(date +%s)" ] && [[ $pid =~ ^[0-9]+$ ]] || continue
      kill "$pid" 2>/dev/null && echo "$p $n: CLI lease expired"
    done
  done
  return 0
}

cmd_lease() {
  local p=${1:-} ttl=8h dir=. root n secs until out
  case $p in android|web|ios) shift ;; *) usage ;; esac
  while [ $# -gt 0 ]; do
    case $1 in
      --ttl) [ $# -ge 2 ] || usage; ttl=$2; shift 2 ;;
      -*) usage ;;
      *) dir=$1; shift ;;
    esac
  done
  [[ $ttl =~ ^([0-9]{1,5})([mhd])$ ]] || die "--ttl $ttl: <n>m, <n>h or <n>d" 2
  case ${BASH_REMATCH[2]} in m) secs=60 ;; h) secs=3600 ;; d) secs=86400 ;; esac
  secs=$((10#${BASH_REMATCH[1]} * secs))
  [ "$secs" -gt 0 ] && [ "$secs" -le $((7 * 86400)) ] || die "--ttl $ttl: from 1m to 7d" 2
  [ -d "$dir" ] || die "no directory $dir" 2
  root=$(sim_root "$dir")
  if n=$(sim_my_slot "$p" "$root"); then
    echo "$p slot $n already leased for $root ($(lease_state "$p" "$n" | cut -d' ' -f2-4))"; return 0
  fi
  until=$(($(date +%s) + secs))
  # The holder reports on the pipe (the slot, or why it got none), then closes it and sleeps: the $(...) returns then.
  out=$(cd "$root" && setsid -f "$REPO/bin/sim" _hold "$p" "$root" "$until" </dev/null 2>&1) || true
  [[ $out =~ ^[1-9]$ ]] || { printf '%s\n' "$out" >&2; exit 3; }
  echo "$p slot $out leased for $root until $(at_time "$until") (sim release $p)"
}

cmd_hold() { # _hold <platform> <root> <until>: the CLI lease holder, started by cmd_lease
  local p=$1 root=$2 until=$3
  sim_lease "$p" "$root" cli "$until" || exit 1
  echo "$SIM_SLOT"
  exec sleep $((until - $(date +%s))) >/dev/null 2>&1
}

cmd_release() {
  local p=${1:-} dir=${2:-.} root n count pid mcp=
  case $p in android|web|ios) ;; *) usage ;; esac
  [ -d "$dir" ] || die "no directory $dir" 2
  root=$(sim_root "$dir"); count=$(sim_slots "$p")
  for ((n = 1; n <= count; n++)); do
    sim_held "$p" "$n" && [ "$(sim_owner_field "$p" "$n" root)" = "$root" ] || continue
    pid=$(sim_owner_field "$p" "$n" pid)
    if [ "$(lease_kind "$p" "$n")" != cli ]; then mcp=${mcp:-$pid}; continue; fi
    kill "$pid" 2>/dev/null || true
    local i; for ((i = 0; i < 50; i++)); do sim_held "$p" "$n" || break; sleep 0.1; done
    sim_held "$p" "$n" && die "$p slot $n is still held by pid $pid"
    echo "$p slot $n released"; return 0
  done
  [ -z "$mcp" ] || die "$p slot of $root is held by the sim-$p MCP server (pid $mcp); end that harness session to free it"
  echo "no $p lease for $root: nothing to release"
}

# sim _wake <platform> <N> (hidden, run by bin/sim-mcp-relay.mjs before tool calls): start or boot slot N's device
# and wait until it can take a call. Exit 0 ready, 3 unavailable (Mac unreachable, device not up in time), 1 other
# failure, with the reason as the last line on stderr: the relay hands it to the agent as the call's error.
# <N>.booted says this host has seen agent-ios-N booted since the last time sim shut it down (reap, ios stop).
cmd_wake() {
  local p=${1:-} n=${2:-} unit rc=0
  case $p in android|web|ios) ;; *) usage ;; esac
  [[ $n =~ ^[1-9]$ ]] || usage
  sim_touch "$p" "$n"
  case $p in
    android)
      unit=$(sim_android_unit "$n")
      if ! systemctl --user is-active -q "$unit"; then
        echo "sim: starting $(sim_android_serial "$n"); this call waits for the boot" >&2
        mobilecli_stop "$n"
        systemctl --user start "$unit" >/dev/null 2>&1 || die "could not start $unit (sim android logs $n)"
      fi
      # Checked on every wake: an emulator restarted behind this session's back is up but not booted yet.
      [ "$( (eval "$(sim_android_env "$n")"; timeout 10 adb shell getprop sys.boot_completed) 2>/dev/null | tr -d '\r')" = 1 ] \
        || sim_android_wait "$n" "${SIM_BOOT_TIMEOUT:-180}" \
        || unavailable "$(sim_android_serial "$n") did not boot within ${SIM_BOOT_TIMEOUT:-180} s (sim android logs $n)" ;;
    ios)
      sim_mac_probe || rc=$?
      case $rc in
        0) ;;
        2) die "AGENT_IOS_HOST and AGENT_IOS_USER must be set in .env (docs/simulators-plan.md)" ;;
        *) unavailable "mac unreachable: $AGENT_IOS_USER@$AGENT_IOS_HOST did not answer within ${SIM_MAC_PROBE_TIMEOUT:-5} s; try again later (sim status)" ;;
      esac
      if [ -e "$SIM_STATE/ios/$n.down" ] || [ ! -e "$SIM_STATE/ios/$n.booted" ]; then
        echo "sim: booting $(sim_ios_name "$n") on the Mac" >&2
        sim_ios_boot "$n" || die "could not boot $(sim_ios_name "$n") on $AGENT_IOS_HOST (sim ios start $n shows why)"
        touch "$SIM_STATE/ios/$n.booted"; rm -f "$SIM_STATE/ios/$n.down"
      fi ;;
  esac
}

# sim _mac down|up <N> (hidden, run by bin/sim-mcp-relay.mjs for sim-mcp ios): down when the session's link to the
# Mac drops (the Mac cached as down, its shared ssh master dropped), up once the relay has reconnected (cached as up,
# <N>.booted removed so the next wake checks the simulator again).
cmd_mac() {
  local s=${1:-} n=${2:-}
  [[ $n =~ ^[1-9]$ ]] || usage
  case $s in
    down) sim_mac_record down ;;
    up) sim_mac_record up; rm -f "$SIM_STATE/ios/$n.booted" ;;
    *) usage ;;
  esac
}

sub=${1:-}; [ $# -gt 0 ] && shift
case $sub in
  status) cmd_status ;;
  reap) cmd_reap ;;
  enable) cmd_enable "$@" ;;
  wait) cmd_wait "$@" ;;
  env) cmd_env ;;
  run) cmd_run "$@" ;;
  ports) cmd_ports "$@" ;;
  build) cmd_build "$@" ;;
  maestro) cmd_maestro "$@" ;;
  metro) cmd_metro "$@" ;;
  android) cmd_android "$@" ;;
  ios) cmd_ios "$@" ;;
  lease) cmd_lease "$@" ;;
  release) cmd_release "$@" ;;
  tunnel) cmd_tunnel "$@" ;;
  _hold) cmd_hold "$@" ;;
  _wake) cmd_wake "$@" ;;
  _mac) cmd_mac "$@" ;;
  _tunnel_watch) cmd_tunnel_watch "$@" ;;
  doctor) cmd_doctor "$@" ;;
  *) usage ;;
esac
