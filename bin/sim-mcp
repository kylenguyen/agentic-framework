#!/usr/bin/env bash
# sim-mcp <android|web|ios>: stdio MCP server for one simulator slot, started by a harness from a repo that ran
# `sim enable`. Leases a slot, the one this worktree had last if it is free (lib/sim.sh), and runs the real server
# as its child for as long as the harness keeps it, then exits, which frees the slot. Only this process holds the
# lock: the server and every helper run with the descriptor closed, so nothing they leave behind (an adb daemon, a
# mise helper) can keep the slot.
# stdout belongs to the MCP protocol: every message goes to stderr.
# The harness's messages reach the server through a relay (bin/sim-mcp-relay.mjs, Node) that wakes the slot's device
# before each tool call: the lease starts nothing, `sim reap` stops a device left idle (lib/sim.sh, Uptime), and the
# call that needs it again waits for the boot (about 30 s for an emulator, a few seconds for an iOS simulator). A
# device that does not come up turns the call into a tool error with the reason; other messages are not held up.
#   android  mobile-mcp, seeing only its own emulator (the slot's adb server)
#   web      Playwright MCP, headless, in-memory profile; SIM_WEB_BROWSER=webkit|firefox|chromium (default chromium)
#   ios      XcodeBuildMCP on the Mac over ssh, its session defaults pinned to simulator agent-ios-N. When the Mac drops
#            off, the session and its lease stay: calls get a "reconnecting" tool error until the relay is back
set -euo pipefail
REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
. "$REPO/lib/sim.sh"
say() { printf 'sim-mcp: %s\n' "$*" >&2; }

platform=${1:-}
case $platform in android|web|ios) ;; *) echo "usage: sim-mcp <android|web|ios>" >&2; exit 2 ;; esac
sim_load_params
root=$(sim_root)
relay_opts=()
sim_lease "$platform" "$root" || exit 1
n=$SIM_SLOT
say "$platform slot $n leased for $root (bin/sim status)"

case $platform in
  android)
    eval "$(sim_android_env "$n" {SIM_LOCK_FD}>&-)"
    export MOBILEMCP_DISABLE_TELEMETRY=1
    # mobile-mcp drives the device through mobilecli, whose daemon is found by its socket in MOBILECLI_HOME (default
    # ~/.mobilecli) and keeps the adb server it started with: shared, every slot would drive the first one's emulator.
    # One daemon per slot, stopped when the session ends.
    export MOBILECLI_HOME=$SIM_STATE/android/$n.mobilecli
    mkdir -p "$MOBILECLI_HOME"
    after=("$SIM_PREFIX/node_modules/.bin/mobilecli" daemon stop)
    server=("${SIM_NODE:-node}" "$SIM_PREFIX/node_modules/@mobilenext/mobile-mcp/lib/index.js")
    ;;
  web)
    # Snapshots and screenshots land here, in RAM ($XDG_RUNTIME_DIR): each lease starts from an empty directory.
    out=$SIM_STATE/web/$n.out
    rm -rf -- "$out"; mkdir -p "$out"
    server=("${SIM_NODE:-node}" "$SIM_PREFIX/node_modules/@playwright/mcp/cli.js" --headless --isolated
      --browser "${SIM_WEB_BROWSER:-chromium}" --output-dir "$out")
    ;;
  ios)
    # -T: no terminal, the channel carries JSON-RPC only. The launcher on the Mac is written by install-ios-runner.sh.
    # The server's ssh is a connection of its own (SIM_SSH_SOLO_OPTS): a dropped shared master must not end it.
    rc=0; sim_mac_probe --fresh {SIM_LOCK_FD}>&- || rc=$?
    case $rc in
      0) ;;
      2) say "AGENT_IOS_HOST and AGENT_IOS_USER must be set in .env (docs/simulators-plan.md)"; exit 1 ;;
      *) say "mac unreachable: $AGENT_IOS_USER@$AGENT_IOS_HOST did not answer within ${SIM_MAC_PROBE_TIMEOUT:-5} s (sim status)"; exit 1 ;;
    esac
    rm -f "$SIM_STATE/ios/$n.booted"     # a new session checks the simulator once, whatever the last one saw
    server=(ssh "${SIM_SSH_SOLO_OPTS[@]}" "${SIM_SSH_OPTS[@]}" -T "$AGENT_IOS_USER@$AGENT_IOS_HOST" ".local/bin/sim-xcodebuildmcp $n")
    # A dropped link does not end the session: the relay keeps the lease and reconnects (bin/sim-mcp-relay.mjs).
    relay_opts=(--reconnect --host "$AGENT_IOS_USER@$AGENT_IOS_HOST"
      --on-drop "$(printf '%q ' "$REPO/bin/sim" _mac down "$n")" --on-up "$(printf '%q ' "$REPO/bin/sim" _mac up "$n")")
    ;;
esac

# The relay (bin/sim-mcp-relay.mjs) owns the server and stdout: it runs `sim _wake` before each batch of tool calls
# (start or boot the slot's device, wait for it) and answers a call whose device does not come up with a tool error.
# The harness ends the session by closing stdin (the relay closes the server's stdin, then kills its process group)
# or by signalling this process: pass the signal on, so no server outlives its lease.
"${SIM_RELAY_NODE:-node}" "$REPO/bin/sim-mcp-relay.mjs" --platform "$platform" --slot "$n" \
  --wake "$(printf '%q ' "$REPO/bin/sim" _wake "$platform" "$n")" --pgid-file "$SIM_STATE/$platform/$n.pgid" \
  "${relay_opts[@]}" -- "${server[@]}" {SIM_LOCK_FD}>&- <&0 &      # <&0: an async command would get /dev/null
child=$!
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
while :; do
  wait "$child" && { rc=0; break; }
  rc=$?
  kill -0 "$child" 2>/dev/null && continue     # wait was cut short by a trapped signal: wait again
  break
done
[ -z "${after:-}" ] || "${after[@]}" {SIM_LOCK_FD}>&- </dev/null >/dev/null 2>&1 || true
exit "$rc"
