#!/usr/bin/env bash
# bin/agent: harness sessions on the host, and the picker every login lands in.
# Installed to ~/.local/bin/agent by install-host.sh; config/bashrc.d/tmux-autoattach.sh runs `agent pick`
# for interactive SSH/mosh logins.
#
# Usage:
#   agent new <repo> [--harness claude|codex|omp|opencode|shell] [--slug <slug>] [--name <name>] [--no-attach]
#   agent ls [--porcelain]
#   agent attach <name>
#   agent pick [--switch]        # --switch only inside tmux (the Ctrl+B g popup); implied by $TMUX
#   agent switch                 # alias for: agent pick --switch
#   agent kill <name> [--force] [--keep-worktree]
#
# Model: one harness run in one repo is one tmux "base" session, never attached directly. Each device
# attaches its own "view" session (<name>@<n>) grouped with the base: shared processes, own current window,
# size and scroll. A view is destroyed when it loses its client (destroy-unattached); the base survives, and
# a finished or crashed harness keeps its last screen (remain-on-exit) until `agent kill`. tmux is the only
# state: no registry file, nothing survives a reboot. A worktree made by `agent new --slug` is removed by
# `agent kill`: the directory only, never the agent/<slug> branch, and never silently while it has
# uncommitted changes.
#
# Session names never contain "." or ":": tmux rewrites the first and treats both as target separators.
# Names are for display; every command resolves a name to a session id once and then uses the id.
#
# The picker's job ends when the operator is in a session: enter_session switches the client when one exists
# ($TMUX) and attaches a new one otherwise, and a popup closes rather than redrawing over the session it
# moved to. Nothing in a picker flow may exit the process (see fail): that process is the login shell.
#
# Test hooks: AGENT_TMUX_SOCKET routes every tmux call to that socket (-L), keeping the tests off the live
# server. AGENT_PICK_FILTER makes `pick` non-interactive: a ";"-separated list of fzf filters, one per menu
# in the order a flow's menus appear ("kill session;scratch" walks the kill flow). Each menu takes the first
# match of its filter, a menu without one takes its first row, and the loop runs once. --porcelain is the
# interface phase 5 and the tests consume: keep its columns stable.
set -euo pipefail

WORKSPACE=$HOME/workspace
HARNESSES="claude codex omp opencode shell"
# Field separator for tmux format output and the rows built from it. Printable on purpose: tmux 3.4 rewrites
# tab and newline in a format result to "_" and escapes other non-printable bytes as \NNN, so nothing would
# split. Session names are sanitised to exclude it, and the two path fields come last in the tmux format so
# the final read variable absorbs anything odd. A repo directory with "|" in its name is the one case this
# does not survive.
SEP='|' 
TMUX_ARGS=()
if [ -n "${AGENT_TMUX_SOCKET:-}" ]; then TMUX_ARGS=(-L "$AGENT_TMUX_SOCKET"); fi

tm()   { tmux "${TMUX_ARGS[@]}" "$@"; }
note() { printf '%s\n' "$*" >&2; }
die()  { printf 'agent: %s\n' "$1" >&2; exit "${2:-1}"; }
# fail is die for anything the picker can reach: an exit inside a picker flow takes the login shell's
# `agent pick` with it and drops the operator at a bare shell instead of the menu. Every caller is either an
# `if cmd; then` in the picker or a bare call from the dispatch, where set -e turns the status into the exit.
fail() { printf 'agent: %s\n' "$1" >&2; return "${2:-1}"; }
# PICK_NOTE carries one line of bad news from a flow that gave up to the menu that draws next, as fzf's
# header. Without it a failed flow is invisible: fzf repaints the screen over whatever was printed.
PICK_NOTE=""

usage() {
  cat >&2 <<'USAGE'
usage: agent <command>
  new <repo> [--harness claude|codex|omp|opencode|shell] [--slug <slug>] [--name <name>] [--no-attach]
  ls [--porcelain]
  attach <name>
  pick [--switch]
  switch
  kill <name> [--force] [--keep-worktree]
USAGE
  exit "${1:-2}"
}

# --- naming -------------------------------------------------------------------------------------------

# "." and ":" because tmux rewrites the first and splits targets on the second; "|" and "," because they
# are this script's field separator and the separator inside a list-sessions filter; whitespace because the
# picker reads a row's name as its first word (`${sel%% *}`).
sanitise() { printf '%s' "${1//[[:space:].:|,]/_}"; }

# Names are resolved through a list-sessions filter, never through a -t target: a bare name in -t is a
# prefix match, and the "=name" exact form is only understood where -t is a target-session, which
# display-message and set-option are not. Everything downstream targets the session id.
session_id() { tm list-sessions -F '#{session_id}' -f "#{==:#{session_name},$1}" 2>/dev/null | head -1; }
session_exists() { [ -n "$(session_id "$1")" ]; }

unique_name() {                                                  # <want> -> want, want-2, want-3, ...
  local want=$1 name=$1 n=2
  while session_exists "$name"; do name="$want-$n"; n=$((n + 1)); done
  printf '%s' "$name"
}

free_view_name() {                                               # <base> -> base@1, base@2, ... first free
  local base=$1 n=1
  while session_exists "$base@$n"; do n=$((n + 1)); done
  printf '%s@%s' "$base" "$n"
}

is_view() {                                                      # is_view <name> <id>: grouped and <base>@<n>
  case $1 in
    *@[0-9]*) [ "$(tm display-message -p -t "$2" '#{session_grouped}' 2>/dev/null || echo 0)" = 1 ] ;;
    *) return 1 ;;
  esac
}

device() {                                                       # the Mac's address, as ssh saw it
  local d=${SSH_CLIENT:-}
  d=${d%% *}
  printf '%s' "${d:-local}"
}

# --- logging out from inside tmux ---------------------------------------------------------------------

# "log out" chosen in the prefix-g popup has to reach a process it cannot see: the login shell sitting in
# its own `agent pick`, whose exit code tmux-autoattach.sh turns into a logout. The popup can only detach
# the client, and a detach alone sends that shell round its loop and draws the picker again. So the popup
# leaves a mark in the tmux server environment, named after the client's tty (one login shell, one tty, one
# mark), and the picker loop claims the mark on its way round and returns 3. The mark dies with the server.
logout_var() {                                                   # <tty> -> environment variable name
  local t=${1:-}
  [ -n "$t" ] || t=$(tty 2>/dev/null) || t=""
  printf 'AGENT_LOGOUT_%s' "${t//[^A-Za-z0-9]/_}"
}

logout_mark() { tm set-environment -g "$(logout_var "${1:-}")" 1 2>/dev/null || true; }
logout_drop() { tm set-environment -gu "$(logout_var "${1:-}")" 2>/dev/null || true; }

logout_claim() {                                                 # true once per mark, then it is gone
  local v
  v=$(logout_var "${1:-}")
  tm show-environment -g "$v" >/dev/null 2>&1 || return 1
  tm set-environment -gu "$v" 2>/dev/null || true
}

# --- sessions -----------------------------------------------------------------------------------------

# session_create <name> <harness> <repo> <cwd> <branch>: the base session, with the facts the picker shows.
# The harness is the session command, so tmux runs it through default-shell -c (zsh), which reads ~/.zshenv
# and so gets PATH and ~/.config/agents/env. remain-on-exit is set on the harness window only: extra windows
# the operator opens close normally.
session_create() {
  local name=$1 harness=$2 repo=$3 cwd=$4 branch=$5 sid wid
  local new=(new-session -d -P -F "#{session_id}${SEP}#{window_id}" -s "$name" -c "$cwd")
  [ "$harness" = shell ] || new+=("$harness")
  IFS=$SEP read -r sid wid < <(tm "${new[@]}")
  [ -n "$sid" ] || { fail "tmux did not create $name"; return; }
  tm set-option -t "$sid" remain-on-exit on
  tm set-option -t "$sid" @harness "$harness"
  tm set-option -t "$sid" @repo    "$repo"
  tm set-option -t "$sid" @cwd     "$cwd"
  tm set-option -t "$sid" @branch  "$branch"
  tm set-option -t "$sid" @created "$(date +%s)"
  tm set-option -t "$sid" @hwin    "$wid"
}

cmd_new() {
  local repo="" harness=claude slug="" name="" attach=1 root cwd branch
  while [ $# -gt 0 ]; do
    case $1 in
      --harness) [ $# -ge 2 ] || usage; harness=$2; shift 2 ;;
      --slug)    [ $# -ge 2 ] || usage; slug=$2;    shift 2 ;;
      --name)    [ $# -ge 2 ] || usage; name=$2;    shift 2 ;;
      --no-attach) attach=0; shift ;;
      -*) usage ;;
      *) [ -z "$repo" ] || usage; repo=$1; shift ;;
    esac
  done
  [ -n "$repo" ] || usage
  case " $HARNESSES " in *" $harness "*) ;; *) fail "unknown harness: $harness (one of: $HARNESSES)" 2; return ;; esac
  root=$WORKSPACE/$repo
  [ -d "$root" ] || { fail "no such repo: $root" 2; return; }
  cwd=$root
  if [ -n "$slug" ]; then
    cwd=$WORKSPACE/$repo.wt/$slug
    # Three cases, because `agent kill` removes a worktree directory and keeps its branch: the worktree
    # exists (pick it up), only the branch is left (check it out again: the same work resumed), or neither
    # exists (start both). Only the third can use -b.
    if [ -d "$cwd" ]; then
      note "reusing worktree $cwd"
    elif git -C "$root" rev-parse --verify -q "refs/heads/agent/$slug" >/dev/null 2>&1; then
      note "reusing branch agent/$slug"
      git -C "$root" worktree add "$cwd" "agent/$slug" >&2 || { PICK_NOTE="git worktree add failed for agent/$slug"; fail "$PICK_NOTE"; return; }
    else
      git -C "$root" worktree add "$cwd" -b "agent/$slug" >&2 || { PICK_NOTE="git worktree add failed for agent/$slug"; fail "$PICK_NOTE"; return; }
    fi
  fi
  branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
  [ -n "$branch" ] || branch=-
  [ -n "$name" ] || name=$repo${slug:+-$slug}   # the harness is its own picker column, so it is not in the name
  name=$(unique_name "$(sanitise "$name")")
  session_create "$name" "$harness" "$repo" "$cwd" "$branch" || return
  if [ "$attach" = 1 ]; then enter_session "$name"; else printf '%s\n' "$name"; fi
}

# A view attaches in the foreground: tmux runs the whole command list server-side and the client is attached
# by new-session itself, so destroy-unattached is armed on a session that already has a client.
cmd_attach() {
  local name=${1:-} id vname
  [ -n "$name" ] || usage
  id=$(session_id "$name") || true
  [ -n "$id" ] || { fail "no such session: $name" 2; return; }
  ! is_view "$name" "$id" || { fail "$name is a view; attach ${name%@*} instead" 2; return; }
  vname=$(free_view_name "$name")
  # The two set-options carry no -t on purpose: they run in the client new-session just attached, so the
  # current session is the view. Arming destroy-unattached any earlier would destroy it before the attach.
  tm new-session -t "$id" -s "$vname" \
     ';' set-option destroy-unattached on \
     ';' set-option @device "$(device)"
}

# enter_session <name>: put this terminal in that session. Inside tmux there is already a client and
# `new-session -t` refuses to nest, so the client is switched; outside tmux one attaches. Every way of
# arriving at a session goes through here, because the choice depends on where the command was typed.
enter_session() {
  if [ -n "${TMUX:-}" ]; then cmd_switch_to "$1"; else cmd_attach "$1"; fi
}

# Inside tmux the view cannot be created attached, so it is created detached with destroy-unattached off,
# switched to, and only then armed. The view the client came from loses its client and destroys itself.
cmd_switch_to() {
  local name=$1 id vname vid
  id=$(session_id "$name") || true
  [ -n "$id" ] || { fail "no such session: $name" 2; return; }
  ! is_view "$name" "$id" || { fail "$name is a view; attach ${name%@*} instead" 2; return; }
  vname=$(free_view_name "$name")
  vid=$(tm new-session -d -P -F '#{session_id}' -t "$id" -s "$vname")
  tm set-option -t "$vid" @device "$(device)"
  tm switch-client -t "$vid"
  tm set-option -t "$vid" destroy-unattached on
}

# --- worktrees ----------------------------------------------------------------------------------------

# The main checkout a worktree belongs to, asked of git rather than parsed out of the path: --git-common-dir
# points at the main repo's .git from anywhere inside a linked worktree (and is the relative ".git" when the
# directory is a main checkout, which is why it is resolved against the worktree first).
main_checkout() {
  local cwd=$1 common
  common=$(git -C "$cwd" rev-parse --git-common-dir 2>/dev/null) || return 1
  case $common in /*) ;; *) common=$cwd/$common ;; esac
  (cd "$common/.." 2>/dev/null && pwd) || return 1
}

wt_dirty() { [ -n "$(git -C "$1" status --porcelain 2>/dev/null)" ]; }

# confirm_dirty <cwd>: 0 means remove it anyway. The question goes to /dev/tty, not stdin, because in the
# picker stdin belongs to fzf. No terminal to ask (a script, the tests, a closing popup) is a "no", the only
# answer that cannot lose work; it is detected by opening /dev/tty rather than testing it, since the device
# file is readable even where opening it fails with ENXIO for want of a controlling terminal.
confirm_dirty() {
  local cwd=$1 ans=""
  exec 3<>/dev/tty 2>/dev/null || return 1
  {
    printf '%s has uncommitted changes:\n' "$cwd"
    git -C "$cwd" status --porcelain | sed 's/^/  /'
    printf 'Remove the worktree anyway? [y/N] '
  } >&3
  read -r ans <&3 || ans=""
  exec 3>&-
  case $ans in [yY] | [yY][eE][sS]) return 0 ;; *) return 1 ;; esac
}

# --- kill ---------------------------------------------------------------------------------------------

# `agent new --slug` created the worktree, so `agent kill` removes it and ~/workspace/<repo>.wt does not fill
# with checkouts nobody is in. The directory only: the agent/<slug> branch is kept, so every commit made in
# the worktree stays reachable.
#
# The worktree is decided on before anything is killed: the operator has to be able to answer while their
# terminal exists, and killing the session a picker popup stands in ends the popup with it.
cmd_kill() {
  local name="" force=0 keep=0 id cwd repo root="" branch vid vname is_wt=0 remove=0 hint="" rmargs=()
  while [ $# -gt 0 ]; do
    case $1 in
      -f | --force)    force=1; shift ;;
      --keep-worktree) keep=1;  shift ;;
      -*) usage ;;
      *) [ -z "$name" ] || usage; name=$1; shift ;;
    esac
  done
  [ -n "$name" ] || usage
  id=$(session_id "$name") || true
  [ -n "$id" ] || { fail "no such session: $name" 2; return; }
  cwd=$(tm display-message -p -t "$id" '#{@cwd}' 2>/dev/null || true)
  repo=$(tm display-message -p -t "$id" '#{@repo}' 2>/dev/null || true)
  branch=$(tm display-message -p -t "$id" '#{@branch}' 2>/dev/null || true)
  # Only a worktree on disk is worth deciding about: a session in the main checkout, or one whose directory
  # was removed by hand, leaves nothing to decide and nothing to say.
  case $cwd in "$WORKSPACE"/*.wt/*) [ ! -d "$cwd" ] || is_wt=1 ;; esac
  if [ "$is_wt" = 1 ]; then
    root=$(main_checkout "$cwd" 2>/dev/null || true)
    [ -n "$root" ] || root=$WORKSPACE/$repo
    if [ "$keep" = 1 ]; then
      remove=0
    elif [ "$force" = 1 ] || ! wt_dirty "$cwd"; then
      remove=1
    elif confirm_dirty "$cwd"; then
      remove=1; force=1
    fi
  fi
  # The views only share the base's windows; killing the base would leave each device attached to a
  # session nobody owns any more, so the whole group goes, views first.
  while IFS=$SEP read -r vid vname; do
    case $vname in "$name"@[0-9]*) tm kill-session -t "$vid" 2>/dev/null || true ;; esac
  done < <(tm list-sessions -F "#{session_id}${SEP}#{session_name}" 2>/dev/null)
  tm kill-session -t "$id"
  [ -n "$root" ] || return 0
  if [ "$remove" = 1 ]; then
    rmargs=(worktree remove)
    [ "$force" = 0 ] || rmargs+=(--force)
    if git -C "$root" "${rmargs[@]}" "$cwd" >&2; then
      printf 'worktree removed: %s (branch %s kept)\n' "$cwd" "${branch:--}"
      return 0
    fi
    note "worktree removal failed"
  fi
  # Kept, by request or because nobody was there to ask: print the command to finish by hand, with the
  # --force the dirty case needs.
  if wt_dirty "$cwd"; then hint="--force "; fi
  printf 'worktree kept: git -C %s worktree remove %s%s\n' "$root" "$hint" "$cwd"
}

# --- listing ------------------------------------------------------------------------------------------

# rows: name harness repo branch wt cwd state created devices, SEP-separated, oldest first.
# One line per base session. A session with no @harness (made by hand) is a shell session and is listed,
# never killed. Views are not listed; their @device lands in their base's devices column.
rows() {
  local fmt raw dead sid name grouped created created_opt harness repo branch cwd hwin dev attached path base wt state
  fmt="#{session_id}${SEP}#{session_name}${SEP}#{session_grouped}${SEP}#{session_created}${SEP}#{@harness}"
  fmt="$fmt${SEP}#{@repo}${SEP}#{@branch}${SEP}#{@hwin}${SEP}#{@device}${SEP}#{session_attached}"
  fmt="$fmt${SEP}#{@created}${SEP}#{pane_current_path}${SEP}#{@cwd}"      # paths last: see SEP above
  raw=$(tm list-sessions -F "$fmt" 2>/dev/null) || return 0
  [ -n "$raw" ] || return 0
  dead=$(tm list-panes -a -F "#{window_id}${SEP}#{pane_dead}" 2>/dev/null || true)
  declare -A devices=() dead_of=()
  local w d
  while IFS=$SEP read -r w d; do [ -z "$w" ] || [ "$d" != 1 ] || dead_of[$w]=1; done <<<"$dead"
  # pass 1: views contribute their device to the base they are grouped with
  while IFS=$SEP read -r sid name grouped created harness repo branch hwin dev attached created_opt path cwd; do
    [ -n "$name" ] || continue
    [ "$grouped" = 1 ] || continue
    case $name in *@[0-9]*) ;; *) continue ;; esac
    [ "$attached" -ge 1 ] 2>/dev/null || continue
    base=${name%@*}
    devices[$base]=${devices[$base]:+${devices[$base]},}${dev:-local}
  done <<<"$raw"
  # pass 2: the base sessions themselves
  while IFS=$SEP read -r sid name grouped created harness repo branch hwin dev attached created_opt path cwd; do
    [ -n "$name" ] || continue
    if [ "$grouped" = 1 ]; then case $name in *@[0-9]*) continue ;; esac; fi
    state=running
    [ -z "$hwin" ] || [ -z "${dead_of[$hwin]:-}" ] || state=exited
    wt=-; case $cwd in "$WORKSPACE"/*.wt/*) wt=wt ;; esac
    printf '%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
      "$name" "$SEP" "${harness:-shell}" "$SEP" "${repo:--}" "$SEP" "${branch:--}" "$SEP" "$wt" "$SEP" \
      "${cwd:-$path}" "$SEP" "$state" "$SEP" "${created_opt:-$created}" "$SEP" "${devices[$name]:--}"
  done <<<"$raw" | sort -t"$SEP" -k8,8n -k1,1
}

age_of() {
  local s now
  now=$(date +%s); s=$((now - $1))
  [ "$s" -ge 0 ] || s=0
  if   [ "$s" -lt 60 ];    then printf '%ds' "$s"
  elif [ "$s" -lt 3600 ];  then printf '%dm' $((s / 60))
  elif [ "$s" -lt 86400 ]; then printf '%dh' $((s / 3600))
  else                          printf '%dd' $((s / 86400)); fi
}

# --- table --------------------------------------------------------------------------------------------

# The picker's palette, as SGR parameters for paint(). Five colours carry meaning and nothing else is
# coloured: green starts or runs, red ends, amber warns, blue is the accent (prompt, pointer, matches, the
# neutral "plain shell" verb), grey is context. 256-colour codes read the same on a light theme as a dark
# one, and every terminal that reaches this menu has them. Harnesses get a hue each so a mixed list scans
# by colour before it is read.
C_DIM='38;5;245' C_RULE='38;5;240' C_ACCENT='38;5;39' C_OK='32' C_BAD='31' C_WARN='38;5;214'
COLOUR=0                                                         # 1 while the picker draws
harness_colour() {
  case $1 in claude) printf '38;5;214' ;; codex) printf '38;5;79' ;; omp) printf '38;5;141' ;; opencode) printf '38;5;75' ;; *) printf '%s' "$C_DIM" ;; esac
}

# paint <sgr> <text>: coloured when COLOUR=1, the text alone otherwise. fzf strips the codes from the row
# it hands back (--ansi), so a painted row still parses by its first word.
paint() {
  if [ "$COLOUR" = 1 ] && [ -n "$1" ]; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi
}

# cell <width> <l|r> <sgr> <text>: one column. Padded to the width (0: as is) and, when CLIP=1, cut to it
# with an ellipsis; then painted. Pad before paint, because printf's field widths would count the escape
# bytes; pad by hand, because printf's widths also count the ellipsis as three bytes under a C locale.
CLIP=0
cell() {
  local w=$1 align=$2 sgr=$3 t=$4 n pad=''
  if [ "$w" -gt 0 ]; then
    n=${#t}
    if [ "$CLIP" = 1 ] && [ "$n" -gt "$w" ]; then t="${t:0:w-1}…"; n=$w; fi
    [ "$n" -ge "$w" ] || printf -v pad '%*s' $((w - n)) ''
  fi
  if [ "$align" = r ]; then paint "$sgr" "$pad$t"; else paint "$sgr" "$t$pad"; fi
}

# ls_human [header]: the aligned columns `agent ls` prints: plain, every column, any width.
ls_human() { COLOUR=0 CLIP=0 table "${1:-0}" 0 0; }

# How every fzf here matches, interactive and --filter alike. --ansi so painted rows match and return as
# plain text. The delimiter and --nth make a row that starts with two spaces unsearchable: its first field
# is the blank margin. The picker's column header is the one such row (table's <indent>); fuzzy matching
# would otherwise find "notes" in NAME REPO WT AGE STATE and land the cursor on the header instead of the
# session. Every other row starts with a glyph or a name, so its first field is the whole line.
FZF_MATCH=(--ansi --delimiter='^  ' --nth=1)

# table <header> <cols> <indent>: the session rows as aligned columns, plus the column header when asked,
# indented by the two-space margin FZF_MATCH keeps unsearchable when <indent> is 1 (its NAME cell is two
# narrower, so the columns line up). <cols> is the width a row has to fit, 0 for every column at any width
# (agent ls). The picker passes what its list can show (UI_TEXT): a phone (about 50) gets NAME AGE STATE, a
# laptop-sized popup adds HARNESS and BRANCH, a full terminal the whole of `agent ls`. NAME is the one
# column that gives way, cut with an ellipsis to what the fixed columns leave and never below 8.
table() {
  local header=$1 cols=$2 indent=${3:-0} all tier=wide w=4 bw=18 fixed=0 sw=7 margin=''
  [ "$indent" = 0 ] || margin='  '
  local name harness repo branch wt cwd state created devices
  all=$(rows)
  [ -n "$all" ] || return 0
  if [ "$cols" -gt 0 ]; then
    if [ "$cols" -lt 70 ]; then tier=narrow; elif [ "$cols" -lt 106 ]; then tier=medium; fi
  fi
  [ "$COLOUR" = 0 ] || sw=9                                      # "● running": glyph, space, state
  while IFS=$SEP read -r name _; do [ "${#name}" -le "$w" ] || w=${#name}; done <<<"$all"
  case $tier in
    narrow) fixed=$((2 + 5 + 2 + sw)) ;;
    medium) fixed=$((2 + 8 + 2 + bw + 2 + 5 + 2 + sw)) ;;
  esac
  if [ "$fixed" -gt 0 ]; then
    CLIP=1
    [ "$w" -le $((cols - fixed)) ] || w=$((cols - fixed))
    [ "$w" -ge 8 ] || w=8
  fi
  # line <sgr-for-all|-> <name> <harness> <repo> <branch> <wt> <age> <state-cell> <devices>
  line() {
    local d=$1 n=$2 h=$3 r=$4 b=$5 t=$6 a=$7 s=$8 v=$9 hc
    hc=$(harness_colour "$h"); [ "$d" = - ] || hc=$d
    case $tier in
      narrow) printf '%s  %s  %s\n' "$(cell "$w" l "${d/-/1}" "$n")" "$(cell 5 r "${d/-/$C_DIM}" "$a")" "$s" ;;
      medium) printf '%s  %s  %s  %s  %s\n' "$(cell "$w" l "${d/-/1}" "$n")" "$(cell 8 l "$hc" "$h")" \
                     "$(cell "$bw" l "${d/-/$C_DIM}" "$b")" "$(cell 5 r "${d/-/$C_DIM}" "$a")" "$s" ;;
      *)      printf '%s  %s  %s  %s  %s  %s  %s  %s\n' "$(cell "$w" l "${d/-/1}" "$n")" "$(cell 8 l "$hc" "$h")" \
                     "$(cell 16 l "${d#-}" "$r")" "$(cell "$bw" l "${d/-/$C_DIM}" "$b")" "$(cell 2 l "${d/-/$C_WARN}" "$t")" \
                     "$(cell 5 r "${d/-/$C_DIM}" "$a")" "$s" "$(cell 0 l "${d/-/$C_DIM}" "$v")" ;;
    esac
  }
  if [ "$header" != 0 ]; then
    w=$((w - ${#margin}))                                        # the margin takes its columns from NAME
    line "$C_DIM" NAME HARNESS REPO BRANCH WT AGE "$(cell "$sw" l "$C_DIM" STATE)" DEVICES | sed "s/^/$margin/"
    w=$((w + ${#margin}))
  fi
  while IFS=$SEP read -r name harness repo branch wt cwd state created devices; do
    [ "$wt" = wt ] || wt=""
    if [ "$COLOUR" = 0 ]; then
      state=$(cell 7 l '' "$state")
    elif [ "$state" = running ]; then
      state="$(paint "$C_OK" '●') $(cell 7 l "$C_OK" running)"
    else
      state="$(paint "$C_BAD" '○') $(cell 7 l "$C_BAD" "$state")"
    fi
    line - "$name" "$harness" "$repo" "$branch" "$wt" "$(age_of "$created")" "$state" "$devices"
  done <<<"$all"
  CLIP=0
}

cmd_ls() {
  case ${1:-} in
    --porcelain) rows | cut -d"$SEP" -f1-4,6-9 | tr "$SEP" '\t' ;;
    "") ls_human 1 ;;
    *) usage ;;
  esac
}

# --- picker -------------------------------------------------------------------------------------------

# Rows carry their own meaning: the five verbs are prefixed with a glyph, every other row starts with a
# session name, so the selected line parses without hidden fields. `kill session` sits below the list, away
# from the rows it destroys. The rule between the groups and the column header are rows too, since fzf has
# no other kind: choosing one is a no-op, and neither matches a filter any verb or name needs.
pick_rows() {
  local list rule
  printf -v rule '%*s' $((UI_TEXT > 10 ? UI_TEXT : 10)) ''
  rule=$(paint "$C_RULE" "${rule// /─}")
  list=$(table 1 "$UI_TEXT" 1)
  printf '%s new session\n%s new shell\n' "$(paint "1;$C_OK" +)" "$(paint "1;$C_OK" +)"
  printf '%s\n' "$rule"
  [ -z "$list" ] || printf '%s\n%s\n' "$list" "$rule"
  printf '%s kill session\n%s plain shell here\n%s log out\n' \
    "$(paint "1;$C_BAD" -)" "$(paint "1;$C_ACCENT" '>')" "$(paint "$C_DIM" x)"
}

# pick_filter <n>: the nth filter in AGENT_PICK_FILTER, counting the menus of one flow from the row that
# starts it. Menus run inside command substitutions and cannot share a queue, so each call site names its
# own position; past the end is empty, which matches everything.
pick_filter() {
  local f=()
  [ -n "${AGENT_PICK_FILTER:-}" ] || return 0
  IFS=';' read -r -a f <<<"$AGENT_PICK_FILTER"
  printf '%s' "${f[$1]-}"
}

term_cols() {
  local c
  c=$(tput cols 2>/dev/null) || c=${COLUMNS:-}
  case $c in '' | *[!0-9]*) c=80 ;; esac
  printf '%s' "$c"
}

# ui_init: the fzf options every menu of one picker run shares, decided once from where it is drawn. The
# list is the whole screen (no preview) and the header sits above the prompt. A border, with the host in
# its label, only when the picker owns the screen and it is wide enough: inside tmux the popup draws one,
# and on a phone the columns are worth more than a frame. fg/bg -1 keeps the terminal's own theme.
ui_init() {
  local host
  UI_COLS=$(term_cols)
  COLOUR=1
  UI_TITLE=""
  host=$(hostname -s 2>/dev/null) || host=host
  FZF_UI=("${FZF_MATCH[@]}" --height=100% --reverse --header-first --cycle --info=inline-right --no-separator
          --pointer='▌' --marker=' ' --ellipsis='…' --no-multi --no-sort
          --color="fg:-1,bg:-1,gutter:236,hl:39,fg+:15,bg+:236,hl+:39,query:15:regular"
          --color="prompt:39,pointer:39,marker:39,spinner:39,info:245,header:245"
          --color="border:240,label:245,separator:240,scrollbar:240")
  UI_TEXT=$((UI_COLS - 3))                                       # pointer column and fzf's right margin
  if [ -z "${TMUX:-}" ] && [ "$UI_COLS" -ge 80 ]; then
    FZF_UI+=(--border=rounded --border-label=" agent · $host " --border-label-pos=3)
    UI_TEXT=$((UI_TEXT - 4))                                     # the border and its inner padding
  elif [ -z "${TMUX:-}" ]; then
    UI_TITLE="agent · $host"
  fi
  # Key hints in two lengths: a phone has no room for the one that only restates what fzf always does.
  if [ "$UI_TEXT" -lt 60 ]; then HINT_TAIL=""; else HINT_TAIL="   type to filter"; fi
  HINT_CHOOSE="↑↓ move   enter choose   esc back$HINT_TAIL"
}

# menu <prompt> <filter> <header-lines> [header line...]: one fzf pass. With AGENT_PICK_FILTER set there is
# no tty, so --filter chooses; an empty filter matches everything and the first row wins. A PICK_NOTE from
# the flow before joins the header lines, painted as a warning. MENU_DANGER=1 turns the prompt and pointer
# red for the one menu that destroys something. <header-lines> input lines are a column header: shown,
# never chosen, left out of --filter's matches.
menu() {
  local prompt=$1 filter=${2:-} hlines=${3:-0} hdr='' l opts=()
  shift 3
  if [ -n "${AGENT_PICK_FILTER:-}" ]; then
    fzf "${FZF_MATCH[@]}" --header-lines="$hlines" --filter="$filter" | head -1
    return 0
  fi
  for l in "$@"; do [ -z "$l" ] || hdr=${hdr:+$hdr$'\n'}$l; done
  [ -z "$PICK_NOTE" ] || hdr=${hdr:+$hdr$'\n'}$(paint "$C_WARN" "⚠ $PICK_NOTE")
  [ -z "$hdr" ] || opts+=(--header="$hdr")
  [ "$hlines" = 0 ] || opts+=(--header-lines="$hlines")
  [ "${MENU_DANGER:-0}" = 0 ] || opts+=(--color="prompt:1,pointer:1")
  fzf "${FZF_UI[@]}" --prompt="$prompt " "${opts[@]}" || return $?
}

# prompt_text <prompt> [header line...]: one line of free text. fzf is the only thing the picker can count
# on, so it is fzf with nothing to match and --print-query. The header says what the answer means and which
# keys do what; without it the empty list reads as a menu that failed to load. Enter accepts (fzf exits 1,
# "no match", the normal path here), Esc exits 130 and cancels; "" is a legitimate answer for the caller.
prompt_text() {
  local prompt=$1 out rc=0 hdr='' l
  shift
  [ -z "${AGENT_PICK_FILTER:-}" ] || return 0
  for l in "$@"; do hdr=${hdr:+$hdr$'\n'}$l; done
  out=$(: | fzf "${FZF_UI[@]}" --print-query --info=hidden --prompt="$prompt " --header="$hdr") || rc=$?
  [ "$rc" = 0 ] || [ "$rc" = 1 ] || return 1
  printf '%s' "$out" | head -1
}

repo_list() {
  local d
  for d in "$WORKSPACE"/*/; do
    d=${d%/}
    case $d in *.wt) continue ;; esac
    [ -e "$d/.git" ] || continue
    printf '%s\n' "$(basename "$d")"
  done
}

# The three pick_* flows return 0 only when the operator ended up somewhere: a session created and entered.
# Backing out of any of their menus, or a flow that could not finish, returns non-zero, which is what keeps
# the popup open on a cancelled flow and closes it on a finished one.
pick_new_session() {
  local repos repo harness slug args
  repos=$(repo_list)
  if [ -z "$repos" ]; then PICK_NOTE="no git repos in $WORKSPACE"; return 1; fi
  repo=$(printf '%s\n' "$repos" | menu 'repo>' "$(pick_filter 1)" 0 \
           "new session: which repo under ~/workspace" "$HINT_CHOOSE") || return 1
  [ -n "$repo" ] || return 1
  harness=$(printf 'claude\ncodex\nomp\nopencode\nshell\n' | menu 'harness>' "$(pick_filter 2)" 0 \
              "new session: which harness runs in $repo" "$HINT_CHOOSE") || return 1
  [ -n "$harness" ] || return 1
  slug=$(prompt_text 'slug>' "new session: $harness in $repo" \
                             "slug: its own worktree, on branch agent/<slug>" \
                             "empty: work in the main checkout" "$HINT_TYPE") || return 1
  args=("$repo" --harness "$harness")
  [ -z "$slug" ] || args+=(--slug "$(sanitise "$slug")")
  cmd_new "${args[@]}"
}

# The picker runs in one of two places, and the difference is the whole of `switch`:
#   switch=0  the login shell's own `agent pick`, outside tmux. It attaches, and the attach only returns when
#             the operator detaches, so the menu is drawn again on the next pass.
#   switch=1  a client that already exists: the prefix-g popup, or `agent pick` typed in a pane. It switches
#             that client and is done; looping would leave the popup on top of the session it moved to.
# Inside tmux an attach cannot work at all (tmux refuses to nest one), so the environment dictates the
# mechanism and the flag only says that a popup expects the menu to be brief. The key hints spell out Esc
# because it differs: at the login picker it ends the connection, in a popup it closes the popup.
HINT_TYPE='enter accept   esc back'
cmd_pick() {
  local switch=0 asked=0 sel rc name hints
  case ${1:-} in
    --switch) switch=1; asked=1; shift ;;
    "") ;;
    *) usage ;;
  esac
  [ $# = 0 ] || usage
  command -v fzf >/dev/null 2>&1 || { fail "fzf is not installed (install-host.sh phase 1)" 2; return; }
  [ "$asked" = 0 ] || [ -n "${TMUX:-}" ] || { fail "--switch only works inside tmux" 2; return; }
  [ -z "${TMUX:-}" ] || switch=1
  ui_init
  if [ "$switch" = 1 ]; then hints="↑↓ move   enter open   esc close$HINT_TAIL"
  else hints="↑↓ move   enter open   esc log out$HINT_TAIL"; fi
  # A mark left on this tty by an earlier login (a popup whose client was never in a picker loop) is stale:
  # this picker is the one that would have claimed it, and it has only just started.
  [ "$switch" = 1 ] || logout_drop
  while :; do
    rc=0
    sel=$(pick_rows | menu 'session>' "$(pick_filter 0)" 0 "$UI_TITLE" "$hints") || rc=$?
    PICK_NOTE=""                                       # the menu that was going to show it has been drawn
    if [ "$rc" != 0 ] || [ -z "$sel" ]; then
      # fzf aborted (Esc, Ctrl+C) or matched nothing: in the popup that just closes it, at the login
      # prompt there is nothing else to do, so it means log out.
      [ "$switch" = 0 ] || return 0
      return 3
    fi
    # Each of these is a question: did the operator end up in a session? If so the picker has done its job
    # and a popup gets out of the way; a login picker stays, because its attach has already come back.
    case $sel in
      '+ new session')      if pick_new_session; then [ "$switch" = 0 ] || return 0; fi ;;
      '+ new shell')        if pick_new_shell;   then [ "$switch" = 0 ] || return 0; fi ;;
      '- kill session')     pick_kill || true ;;
      '> plain shell here') return 0 ;;
      'x log out')          [ "$switch" = 0 ] || { pick_log_out; return 0; }; return 3 ;;
      '─'* | '  '*) : ;;                                 # a rule or the column header: nothing to enter
      *)
        name=${sel%% *}
        if enter_session "$name"; then [ "$switch" = 0 ] || return 0
        else PICK_NOTE="could not enter $name"; fi
        ;;
    esac
    # The attach above (or the one inside new/new shell) has just returned. If it returned because a popup
    # on this client chose "log out", that is this loop's answer, not another round of the menu.
    if [ "$switch" = 0 ] && logout_claim; then return 3; fi
    [ -z "${AGENT_PICK_FILTER:-}" ] || return 0
  done
}

pick_new_shell() {
  local want name
  want=$(prompt_text 'name>' 'new shell: a plain shell in ~/workspace' \
                             'empty: scratch' "$HINT_TYPE") || return 1
  [ -n "$want" ] || want=scratch
  name=$(unique_name "$(sanitise "$want")")
  session_create "$name" shell "" "$WORKSPACE" - || return 1
  enter_session "$name"
}

# Kill is the one verb that destroys work, so it never acts on the row that happened to be highlighted: the
# session is chosen again in a list of its own, under a red prompt and a header that says what will happen.
# Killing the session behind the popup you stand in is allowed and ends the popup with it. A worktree with
# uncommitted changes asks once more, on the terminal.
pick_kill() {
  local list sel name
  list=$(table 1 "$UI_TEXT" 0)
  if [ -z "$list" ]; then PICK_NOTE='no sessions to kill'; return 1; fi
  sel=$(printf '%s\n' "$list" | MENU_DANGER=1 menu 'kill>' "$(pick_filter 1)" 1 \
          "$(paint "$C_WARN" '⚠') kills the harness, its views, its worktree" \
          "↑↓ move   enter kill   esc back$HINT_TAIL") || return 1
  [ -n "$sel" ] || return 1
  name=${sel%% *}
  cmd_kill "$name" || PICK_NOTE="could not kill $name"
}

# Inside tmux the popup cannot end the login shell itself, so it marks the client's tty and detaches it;
# the picker that shell is sitting in claims the mark and exits 3. Detaching also closes this popup.
pick_log_out() {
  local client rc=0
  client=$(tm display-message -p '#{client_tty}' 2>/dev/null) || client=""
  logout_mark "$client"
  if [ -n "$client" ]; then tm detach-client -t "$client" || rc=$?; else tm detach-client || rc=$?; fi
  # Nothing detached means nothing will claim the mark either, so take it back rather than leave it for
  # the next picker on this tty.
  [ "$rc" = 0 ] || { logout_drop "$client"; note 'log out: tmux would not detach this client'; }
}

# --- dispatch -----------------------------------------------------------------------------------------

case ${1:-} in
  new)    shift; cmd_new "$@" ;;
  ls)     shift; cmd_ls "${1:-}" ;;
  attach) shift; cmd_attach "${1:-}" ;;
  pick)   shift; cmd_pick "$@" ;;
  switch) shift; [ $# = 0 ] || usage; cmd_pick --switch ;;
  kill)   shift; cmd_kill "$@" ;;
  -h|--help|help) usage 0 ;;
  *) usage ;;
esac
