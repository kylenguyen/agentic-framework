#!/bin/bash
# clip-push: send the Mac clipboard to the agent host so Claude Code there can paste it.
# WezTerm runs `clip-push --if-image` on Cmd+V in a pane connected to the host (config/wezterm-agent-host.lua.in): an
# image is pushed, clip-put on the host stores it as ~/.clip/<stamp>.png and prints that path (our second output
# line), and WezTerm pastes the path into the pane, which every harness attaches as an image. Text is reported only
# and WezTerm pastes it natively.
# TEMPLATE: install-mac.sh renders @AGENT_HOST@ from .env and installs the result as ~/.local/bin/clip-push (no sudo).
# Usage:   clip-push              push the clipboard (image or text); prints image/png or text/plain
#          clip-push --if-image   push only if the clipboard holds an image; prints the type either way
#          clip-push --clear      delete every copy held on the host (otherwise an image goes on the first push
#                                 made more than 24 h after it; there is no timer, so that can be days later)
# The type is printed before the push so the caller can tell what failed; an image push prints the host path after it.
# CLIP_PUSH_HOST overrides the ssh destination; default <alias>-clip (config/ssh_config.mac.in); <alias>-lan works off the tailnet.
# WezTerm starts child processes with a minimal environment, so PATH is spelled out (Homebrew for pngpaste).
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
set -euo pipefail
host=${CLIP_PUSH_HOST:-@AGENT_HOST@-clip}
remote() { ssh -o BatchMode=yes -o ConnectTimeout=3 "$host" "~/.local/bin/clip-put $*"; }

if_image=0
case "${1:-}" in
  --clear) remote --clear </dev/null; exit 0 ;;
  --if-image) if_image=1 ;;
  "") ;;
  *) echo 'usage: clip-push [--if-image|--clear]' >&2; exit 2 ;;
esac

# `clipboard info` lists classes such as «class PNGf», TIFF picture, «class utf8».
if osascript -e 'clipboard info' 2>/dev/null | grep -qE 'PNGf|TIFF'; then
  echo image/png
  command -v pngpaste >/dev/null || { echo 'clip-push: pngpaste missing (brew install pngpaste)' >&2; exit 1; }
  pngpaste - | remote
else
  echo text/plain
  [ "$if_image" = 1 ] || pbpaste | remote
fi
