# Copy to ~/.config/agents/env (mode 600). Secret names only here; never commit values. Host names and logins are
# not secrets and live in .env (see .env.example), which agents may read; this file they may not.
# Sourced by config/bashrc.d/agents-env.sh for every bash shell and by systemd units (EnvironmentFile).
# Leave a line commented out to keep that provider on its own login (e.g. Claude Code OAuth).
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
#GH_TOKEN=
