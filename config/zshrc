# Interactive zsh on the host: oh-my-zsh plus the interactive fragments bash gets from ~/.bashrc.
# Installed as ~/.zshrc (symlink). PATH and secrets come from ~/.zshenv.
# shellcheck shell=sh

export ZSH="$HOME/.oh-my-zsh"

# Plain theme on purpose: no patched fonts, so it renders the same over SSH or mosh and in any pane an agent opens.
ZSH_THEME="robbyrussell"

# git only. The tmux plugin is deliberately absent: it wraps `tmux` in a shell function in every interactive shell.
plugins=(git)

# Never prompt "update oh-my-zsh?": agents open tmux windows nobody is watching, and a prompt there would hang the
# job. Update by hand with `omz update`.
zstyle ':omz:update' mode disabled

if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  . "$ZSH/oh-my-zsh.sh"
else
  echo "oh-my-zsh missing: run ./install-host.sh (without --no-tools)" >&2
fi

# Same interactive fragments as ~/.bashrc, so bash and zsh behave alike.
[ -r "$HOME/.bashrc.d/mise.sh" ] && . "$HOME/.bashrc.d/mise.sh"
[ -r "$HOME/.bashrc.d/tmux-autoattach.sh" ] && . "$HOME/.bashrc.d/tmux-autoattach.sh"
