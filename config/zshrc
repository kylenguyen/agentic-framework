# Interactive zsh on the host: oh-my-zsh plus the same interactive bits bash gets from ~/.bashrc.
# Installed as ~/.zshrc (symlink). PATH and secrets are already in place from ~/.zshenv.
# shellcheck shell=sh

export ZSH="$HOME/.oh-my-zsh"

# Plain theme on purpose: it needs no patched fonts, so it renders the same in WezTerm over
# SSH or mosh and in any tmux pane an agent opens.
ZSH_THEME="robbyrussell"

# git only. The tmux plugin is deliberately absent: it aliases `tmux` to a wrapper function,
# which would sit in front of the `exec tmux` in tmux-autoattach.sh.
plugins=(git)

# Never prompt "update oh-my-zsh?" in an interactive shell: agent CLIs open tmux windows that
# nobody is watching, and a prompt there would hang the job. Update by hand with `omz update`.
zstyle ':omz:update' mode disabled

if [ -r "$ZSH/oh-my-zsh.sh" ]; then
  . "$ZSH/oh-my-zsh.sh"
else
  echo "oh-my-zsh missing: run ./install-host.sh (without --no-tools)" >&2
fi

# Same interactive fragments as ~/.bashrc, so bash and zsh behave alike. mise.sh picks the
# right `mise activate` for the running shell.
[ -r "$HOME/.bashrc.d/mise.sh" ] && . "$HOME/.bashrc.d/mise.sh"
[ -r "$HOME/.bashrc.d/tmux-autoattach.sh" ] && . "$HOME/.bashrc.d/tmux-autoattach.sh"
