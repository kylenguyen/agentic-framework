# Host sshd hardening. TEMPLATE: install-host.sh (phase 1) renders @AGENT_HOST_USER@ to the login it runs as and
# installs the result to /etc/ssh/sshd_config.d/10-hardening.conf. Never install this file as is: an unrendered
# AllowUsers line matches nobody and locks every account out.
# sshd_config.d files are read in lexical order and the first value wins, so 10- beats 50-cloud-init.conf.
#
# Password login is allowed so a device without a provisioned key can still reach the host.
# Exposure is bounded by ufw (config/ufw.sh): inbound only on tailscale0 and from the LAN /24, never the
# internet. AllowUsers and PermitEmptyPasswords keep the guessable surface to one account with a real password.
PasswordAuthentication yes
PermitEmptyPasswords no
MaxAuthTries 4
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers @AGENT_HOST_USER@
ClientAliveInterval 30
ClientAliveCountMax 4
X11Forwarding no
