# Mac -> as1. Rendered into a marker block in ~/.ssh/config on the Mac by install-mac.sh.
Host as1
  HostName as1
  User kyle
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 30
  ServerAliveCountMax 4
  ForwardAgent no

Host as1-lan
  HostName 192.168.10.2
  User kyle
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 30
  ForwardAgent no

# Used by clip-push when Cmd+V pastes an image into as1. Kept apart from Host as1 so interactive sessions and mosh are
# untouched: BatchMode never prompts, ConnectTimeout keeps a failed push short, ControlMaster reuses one
# connection for 10 minutes so pushes after the first take milliseconds.
Host as1-clip
  HostName as1
  User kyle
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  BatchMode yes
  ConnectTimeout 3
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  ForwardAgent no
  LogLevel ERROR
