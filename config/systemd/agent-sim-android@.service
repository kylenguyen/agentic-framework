# One Android emulator per simulator slot (lib/sim.sh). Linked into ~/.config/systemd/user by install-host.sh.
# Started by bin/sim-mcp when an agent leases slot %i, stopped by `sim android stop %i`; never enabled at boot.
[Unit]
Description=agent-sim Android emulator, slot %i

[Service]
Type=simple
ExecStart=%h/.local/bin/sim android run %i
# The slot's adb server is forked by `sim android run` and survives the emulator; take it down with the unit.
ExecStopPost=/bin/sh -c 'ANDROID_ADB_SERVER_PORT=$((5037 + %i)) %h/Android/Sdk/platform-tools/adb kill-server || true'
KillMode=control-group
TimeoutStopSec=30
Restart=no
