# One Android emulator per simulator slot (lib/sim.sh). Linked into ~/.config/systemd/user by install-host.sh.
# Started by bin/sim-mcp on the first tool call for slot %i (or `sim wait`), stopped by `sim reap` once the slot is
# idle (agent-sim-reap.timer) or by `sim android stop %i`; never enabled at boot.
[Unit]
Description=agent-sim Android emulator, slot %i
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/.local/bin/sim android run %i
# The slot's adb server is forked by `sim android run` and survives the emulator; take it down with the unit.
ExecStopPost=/bin/sh -c 'ANDROID_ADB_SERVER_PORT=$((5037 + %i)) %h/Android/Sdk/platform-tools/adb kill-server || true'
KillMode=control-group
TimeoutStopSec=30
# The emulator now and then segfaults within seconds of starting (seen on 14 Oct 2026, a cause not found); a
# second start comes up. A stop by systemctl is not a failure, so it is never restarted then.
Restart=on-failure
RestartSec=5
