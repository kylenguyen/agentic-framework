#!/bin/sh
# systemctl shim: logs the call; the unattended-upgrades unit is reported enabled and active so install-host.sh
# takes its "ok" path.
echo "systemctl $*" >> /var/log/e2e-shims.log
case "$1 $2" in
  "is-enabled unattended-upgrades") echo enabled ;;
  "is-active unattended-upgrades")  echo active ;;
esac
exit 0
