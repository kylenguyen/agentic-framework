# sim-mac.sh "Mac": a Linux stand-in for the Mac that runs the iOS simulators, reached over real ssh as `runner`,
# whose login shell is zsh as on macOS: ssh runs every command through `zsh -c`, which reads ~/.zshenv, where
# install-ios-runner.sh puts ~/.local/bin on PATH (the same block is written here). ~/.local/bin holds the shims
# from tests/e2e/shims/simmac (xcrun, maestro, npx, sim-xcodebuildmcp); sim-mac.sh adds the real sim-maestro
# launcher, cut out of install-ios-runner.sh. Not covered: macOS itself, /bin/bash 3.2, BSD tools, Xcode.
FROM debian:12-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssh-server rsync bash zsh curl python3 procps ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /usr/bin/zsh runner && usermod -p '*' runner \
    && mkdir -p /run/sshd && ssh-keygen -A \
    && printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' > /etc/ssh/sshd_config.d/50-e2e.conf
COPY --chown=runner:runner shims/simmac/ /home/runner/.local/bin/
RUN chmod 755 /home/runner/.local/bin/* \
    && printf '%s\n' '# >>> agentic-framework:sim >>>' 'export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"' \
         '# <<< agentic-framework:sim <<<' > /home/runner/.zshenv \
    && touch /home/runner/.zshrc && install -d -o runner -g runner -m 700 /home/runner/.ssh \
    && chown -R runner:runner /home/runner
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]
